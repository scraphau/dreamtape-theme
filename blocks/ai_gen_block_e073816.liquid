{% doc %}
  @prompt
    add a newsletter popup
{% enddoc %}

{%- comment -%}
  Newsletter popup.

  Generated by Shopify AI, then reworked: it opened only when someone clicked a
  full-width bar sitting in the page. It now opens on its own after a delay,
  once per visitor, and the bar is optional - a popup nobody sees is not worth
  having, and a permanent navy bar mid-page is a heavy price for a trigger.

  Kept from the original: the block id, every setting id, and Shopify's own
  customer form, so the settings already saved in the template still apply and
  signups still land in Customers.
{%- endcomment -%}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture form_class %}ai-newsletter-popup-{{ ai_gen_id }}__form{% endcapture %}

{% style %}
  .ai-newsletter-popup-{{ ai_gen_id }} { display: block; width: 100%; }

  .ai-newsletter-popup-{{ ai_gen_id }}__trigger {
    display: inline-flex; align-items: center; justify-content: center;
    width: {{ block.settings.desktop_width_percent }}%; max-width: 100%;
    padding: 14px 24px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font: inherit; font-weight: 700; letter-spacing: 0.03em; cursor: pointer;
  }
  {%- unless block.settings.show_trigger %}
  .ai-newsletter-popup-{{ ai_gen_id }}__trigger { display: none; }
  {%- endunless %}

  .ai-newsletter-popup-{{ ai_gen_id }}__overlay {
    position: fixed; inset: 0; z-index: 999;
    display: none; align-items: center; justify-content: center;
    padding: 20px; background: rgba(7, 16, 42, 0.55);
  }
  .ai-newsletter-popup-{{ ai_gen_id }}__overlay.is-open { display: flex; }

  .ai-newsletter-popup-{{ ai_gen_id }}__dialog {
    position: relative; width: min(100%, 440px);
    padding: 52px 34px 26px;
    border-radius: {{ block.settings.popup_radius }}px;
    background: {{ block.settings.popup_background }};
    color: {{ block.settings.popup_text_color }};
    box-shadow: 0 30px 80px -20px rgba(7, 16, 42, 0.55);
    text-align: center;
  }

  /* Ringed circle, matching the close control used elsewhere in the theme. */
  .ai-newsletter-popup-{{ ai_gen_id }}__close {
    position: absolute; top: 14px; right: 14px;
    width: 34px; height: 34px; padding: 0;
    display: flex; align-items: center; justify-content: center;
    border: 2px solid currentColor; border-radius: 50%;
    background: none; color: inherit;
    font-size: 22px; line-height: 1; cursor: pointer; opacity: 0.9;
  }
  .ai-newsletter-popup-{{ ai_gen_id }}__close:hover { opacity: 1; }

  .ai-newsletter-popup-{{ ai_gen_id }}__eyebrow {
    display: block; margin-bottom: 14px;
    font-size: 15px; font-weight: 600; opacity: 0.92;
  }

  /* The display serif, as used by every other heading on the site. */
  .ai-newsletter-popup-{{ ai_gen_id }}__heading {
    margin: 0 0 10px;
    font-family: var(--font-serif, Georgia, serif);
    font-weight: 400;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1; letter-spacing: -0.02em;
  }

  .ai-newsletter-popup-{{ ai_gen_id }}__text {
    margin: 0 0 22px;
    color: {{ block.settings.popup_muted_color }};
    font-size: 14.5px; line-height: 1.55;
  }
  .ai-newsletter-popup-{{ ai_gen_id }}__form { display: grid; gap: 12px; }

  .ai-newsletter-popup-{{ ai_gen_id }}__input {
    width: 100%; box-sizing: border-box;
    padding: 17px 22px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_radius }}px;
    background: {{ block.settings.input_background }};
    color: #0e1a3a; font: inherit; font-size: 15px; text-align: center;
  }
  .ai-newsletter-popup-{{ ai_gen_id }}__input::placeholder { color: #8a93a8; }

  .ai-newsletter-popup-{{ ai_gen_id }}__submit {
    padding: 18px 24px; border: 0;
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font: inherit; font-size: 15.5px; font-weight: 700; letter-spacing: 0.04em;
    cursor: pointer;
  }
  .ai-newsletter-popup-{{ ai_gen_id }}__submit:hover { background: {{ block.settings.button_hover_color }}; }

  .ai-newsletter-popup-{{ ai_gen_id }}__message { margin: 4px 0 0; }
  .ai-newsletter-popup-{{ ai_gen_id }}__code {
    margin: 16px 0 0; padding: 14px;
    border: 1px dashed currentColor; border-radius: 12px;
    font-size: 20px; font-weight: 700; letter-spacing: 0.14em;
  }
  .ai-newsletter-popup-{{ ai_gen_id }}__fine {
    margin: 18px 0 0; font-size: 11.5px; line-height: 1.5;
    color: {{ block.settings.popup_muted_color }};
  }
  .ai-newsletter-popup-{{ ai_gen_id }}__label {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  @media screen and (max-width: 749px) {
    .ai-newsletter-popup-{{ ai_gen_id }}__dialog { padding: 48px 22px 22px; }
  }
{% endstyle %}

<newsletter-popup-{{ ai_gen_id }}
  class="ai-newsletter-popup-{{ ai_gen_id }}"
  data-auto-open="{{ block.settings.auto_open }}"
  data-delay="{{ block.settings.auto_delay }}"
  {{ block.shopify_attributes }}
>
  <button type="button" class="ai-newsletter-popup-{{ ai_gen_id }}__trigger"
    aria-haspopup="dialog" aria-controls="ai-newsletter-dialog-{{ ai_gen_id }}">
    {{ block.settings.trigger_label | escape }}
  </button>

  <div class="ai-newsletter-popup-{{ ai_gen_id }}__overlay" data-overlay>
    <div id="ai-newsletter-dialog-{{ ai_gen_id }}"
      class="ai-newsletter-popup-{{ ai_gen_id }}__dialog"
      role="dialog" aria-modal="true"
      aria-labelledby="ai-newsletter-heading-{{ ai_gen_id }}" tabindex="-1">

      <button type="button" class="ai-newsletter-popup-{{ ai_gen_id }}__close" data-close aria-label="Close">&times;</button>

      {%- if block.settings.eyebrow != blank -%}
        <span class="ai-newsletter-popup-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</span>
      {%- endif -%}

      <h2 id="ai-newsletter-heading-{{ ai_gen_id }}" class="ai-newsletter-popup-{{ ai_gen_id }}__heading">
        {{ block.settings.heading | escape }}
      </h2>

      {%- if block.settings.description != blank -%}
        <p class="ai-newsletter-popup-{{ ai_gen_id }}__text">{{ block.settings.description | escape }}</p>
      {%- endif -%}

      {% form 'customer', class: form_class %}
        {%- if form.posted_successfully? -%}
          <p class="ai-newsletter-popup-{{ ai_gen_id }}__message">{{ block.settings.success_message | escape }}</p>
          {%- if block.settings.discount_code != blank -%}
            <p class="ai-newsletter-popup-{{ ai_gen_id }}__code">{{ block.settings.discount_code | escape }}</p>
          {%- endif -%}
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="newsletter,popup">
          <label for="ai-newsletter-email-{{ ai_gen_id }}" class="ai-newsletter-popup-{{ ai_gen_id }}__label">Email address</label>
          <input id="ai-newsletter-email-{{ ai_gen_id }}"
            class="ai-newsletter-popup-{{ ai_gen_id }}__input"
            type="email" name="contact[email]" autocomplete="email"
            placeholder="{{ block.settings.email_placeholder | escape }}" required>
          <button type="submit" class="ai-newsletter-popup-{{ ai_gen_id }}__submit">
            {{ block.settings.submit_label | escape }}
          </button>
          {%- if form.errors -%}
            <p class="ai-newsletter-popup-{{ ai_gen_id }}__message">Please enter a valid email address.</p>
          {%- endif -%}
        {%- endif -%}
      {% endform %}

      {%- if block.settings.fine_print != blank -%}
        <p class="ai-newsletter-popup-{{ ai_gen_id }}__fine">{{ block.settings.fine_print | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</newsletter-popup-{{ ai_gen_id }}>

<script>
  (function () {
    var KEY = 'dt_np_seen_{{ ai_gen_id }}';

    class NewsletterPopup{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        try {
          this.overlay = this.querySelector('[data-overlay]');
          this.dialog = this.querySelector('[role="dialog"]');
          this.trigger = this.querySelector('.ai-newsletter-popup-{{ ai_gen_id }}__trigger');
          this.closeButton = this.querySelector('[data-close]');

          this.trigger.addEventListener('click', () => this.open());
          this.closeButton.addEventListener('click', () => this.close());
          this.overlay.addEventListener('click', (e) => { if (e.target === this.overlay) this.close(); });
          this.addEventListener('keydown', (e) => { if (e.key === 'Escape') this.close(); });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && this.overlay.classList.contains('is-open')) this.close();
          });

          // ?popup=1 reopens it after it has been seen, which is otherwise
          // impossible without clearing site data.
          var force = window.location.search.indexOf('popup=1') !== -1;

          // Straight open on the redirect back from a successful signup.
          if (window.location.search.indexOf('customer_posted=true') !== -1) return this.open(false);

          if (force) return this.open(false);

          // Never in the theme editor - it would cover what is being edited.
          if (window.Shopify && window.Shopify.designMode) return;
          if (this.dataset.autoOpen !== 'true') return;
          if (this.seen()) return;

          var delay = (parseInt(this.dataset.delay, 10) || 8) * 1000;
          setTimeout(() => this.open(), delay);
        } catch (e) {
          /* the popup simply stays shut */
        }
      }

      seen() {
        try { return !!window.localStorage.getItem(KEY); } catch (e) { return false; }
      }

      remember() {
        try { window.localStorage.setItem(KEY, '1'); } catch (e) {}
      }

      open(persist) {
        this.overlay.classList.add('is-open');
        this.dialog.focus();
        if (persist !== false) this.remember();
      }

      close() {
        this.overlay.classList.remove('is-open');
        this.remember();
        if (this.trigger && this.trigger.offsetParent !== null) this.trigger.focus();
      }
    }

    customElements.define('newsletter-popup-{{ ai_gen_id }}', NewsletterPopup{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Newsletter popup",
  "settings": [
    { "type": "header", "content": "Behaviour" },
    { "type": "checkbox", "id": "auto_open", "label": "Open on its own", "info": "Shows once per visitor. Add ?popup=1 to a URL to see it again.", "default": true },
    { "type": "range", "id": "auto_delay", "label": "Open after", "min": 2, "max": 30, "step": 1, "unit": "s", "default": 8 },
    { "type": "checkbox", "id": "show_trigger", "label": "Show the button on the page", "info": "The full-width bar that opens it. Off by default - the popup opens on its own.", "default": false },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "trigger_label", "label": "Trigger label", "default": "Join our newsletter" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sleep Better. Live Better." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Unlock 10% Off Your First Order" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "submit_label", "label": "Submit label", "default": "GET MY 10% OFF" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "One use per customer. Not valid with subscription discounts." },
    { "type": "header", "content": "After signup" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You are on the list." },
    { "type": "text", "id": "discount_code", "label": "Discount code", "info": "Create this in Discounts first. Leave blank to show no code.", "default": "WELCOME10" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Trigger width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "popup_radius", "label": "Popup radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 100 },
    { "type": "range", "id": "input_radius", "label": "Input radius", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 100 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "popup_background", "label": "Background", "default": "#1b2d5a" },
    { "type": "color", "id": "popup_text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "popup_muted_color", "label": "Secondary text", "default": "#dbe5f6" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#dbe5f6" },
    { "type": "color", "id": "button_hover_color", "label": "Button hover", "default": "#c9d8f0" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#0e1a3a" },
    { "type": "color", "id": "input_background", "label": "Input background", "default": "#ffffff" },
    { "type": "color", "id": "input_border_color", "label": "Input border", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Newsletter popup" }],
  "tag": null,
  "class": "newsletter-popup-block"
}
{% endschema %}
