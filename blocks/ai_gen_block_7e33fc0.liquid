Corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 14}, {"type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}], "default": "center"}, {"type": "header", "content": "Colors"}, {"type": "color", "id": "background_color", "label": "Background", "default": "#f3f6fb"}, {"type": "color", "id": "card_color", "label": "Card", "default": "#ffffff"}, {"type": "color", "id": "heading_color", "label": "Heading", "default": "#0e1a3a"}, {"type": "color", "id": "text_color", "label": "Text", "default": "#0a1432"}, {"type": "color", "id": "muted_color", "label": "Muted text", "default": "#5a6580"}, {"type": "color", "id": "accent_color", "label": "Accent", "default": "#0e1a3a"}, {"type": "color", "id": "border_color", "label": "Borders", "default": "#d9e0ec"}, {"type": "color", "id": "brand_column_color", "label": "Brand column", "default": "#0e1a3a"}, {"type": "color", "id": "brand_text_color", "label": "Brand text", "default": "#ffffff"}, {"type": "color", "id": "yes_background", "label": "Included background", "default": "#dcefe7"}, {"type": "color", "id": "yes_color", "label": "Included icon", "default": "#146b45"}, {"type": "color", "id": "no_background", "label": "Other background", "default": "#eef1f5"}, {"type": "color", "id": "no_color", "label": "Other icon", "default": "#5a6580"}], "presets": [{"name": "Mouth tape comparison"}], "tag": null, "class": "mouth-tape-comparison-block"}{% endschema %}