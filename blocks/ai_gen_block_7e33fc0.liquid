{% doc %}
  @prompt
    add a mouth tape comparison with 6 benefits (compared with dreamtape vs other mouth tapes)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    /* The site's two faces are named outright instead of read from
       --font-serif / --font-sans. The heading kept coming out in the body
       sans on the storefront even after the variable went in, so the block
       no longer depends on those custom properties reaching its cascade. */
    font-family: 'Inter Tight', system-ui, -apple-system, sans-serif;
    box-sizing: border-box;
  }

  .ai-comparison-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
  }

  .ai-comparison-{{ ai_gen_id }}__header {
    max-width: 680px;
    margin: 0 auto 22px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-comparison-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 10px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ai-comparison-{{ ai_gen_id }}__title {
    margin: 0 0 12px;
    color: {{ block.settings.heading_color }};
    font-size: clamp(28px, 4vw, 44px);
    font-family: 'Fraunces', Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-optical-sizing: auto;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .ai-comparison-{{ ai_gen_id }}__intro {
    margin: 0;
    color: {{ block.settings.muted_color }};
    font-size: 15px;
    line-height: 1.55;
  }

  .ai-comparison-{{ ai_gen_id }}__table-wrap {
    overflow-x: auto;
    padding: 22px 0;
  }

  .ai-comparison-{{ ai_gen_id }}__table {
    width: 100%;
    min-width: 560px;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
    background: {{ block.settings.card_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-comparison-{{ ai_gen_id }}__table th,
  .ai-comparison-{{ ai_gen_id }}__table td {
    padding: 12px 20px;
    text-align: center;
    vertical-align: middle;
  }

  .ai-comparison-{{ ai_gen_id }}__table tbody td:first-child,
  .ai-comparison-{{ ai_gen_id }}__table tbody td:nth-child(3) {
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-comparison-{{ ai_gen_id }}__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .ai-comparison-{{ ai_gen_id }}__table tr:last-child td {
    border-bottom: 0;
  }

  .ai-comparison-{{ ai_gen_id }}__table th:first-child,
  .ai-comparison-{{ ai_gen_id }}__table td:first-child {
    width: 58%;
    text-align: left;
  }

  .ai-comparison-{{ ai_gen_id }}__table thead th {
    color: {{ block.settings.heading_color }};
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .ai-comparison-{{ ai_gen_id }}__table th:nth-child(2),
  .ai-comparison-{{ ai_gen_id }}__table td:nth-child(2) {
    position: relative;
    background: {{ block.settings.brand_column_color }};
    border-bottom: 0;
  }

  .ai-comparison-{{ ai_gen_id }}__table thead th:nth-child(2) {
    color: {{ block.settings.brand_text_color }};
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    padding-top: 20px;
  }

  /* Pseudo-elements extend the column past the table, so it reads as a card
     laid over the list rather than a shaded column inside it. */
  .ai-comparison-{{ ai_gen_id }}__table thead th:nth-child(2)::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 22px;
    background: {{ block.settings.brand_column_color }};
    border-radius: 18px 18px 0 0;
  }

  .ai-comparison-{{ ai_gen_id }}__table tbody tr:last-child td:nth-child(2)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 22px;
    background: {{ block.settings.brand_column_color }};
    border-radius: 0 0 18px 18px;
  }

  .ai-comparison-{{ ai_gen_id }}__table thead th:nth-child(3) {
    color: {{ block.settings.muted_color }};
    font-weight: 600;
  }

  .ai-comparison-{{ ai_gen_id }}__table tbody td:first-child {
    color: {{ block.settings.muted_color }};
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
  }

  .ai-comparison-{{ ai_gen_id }}__table tbody td:nth-child(2) {
    background: {{ block.settings.brand_column_color }};
  }

  .ai-comparison-{{ ai_gen_id }}__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font-size: 17px;
    font-weight: 800;
    line-height: 1;
  }

  .ai-comparison-{{ ai_gen_id }}__mark--yes {
    background: {{ block.settings.yes_background }};
    color: {{ block.settings.yes_color }};
  }

  .ai-comparison-{{ ai_gen_id }}__mark--no {
    background: {{ block.settings.no_background }};
    color: {{ block.settings.no_color }};
  }

  .ai-comparison-{{ ai_gen_id }}__note {
    margin: 18px 0 0;
    color: {{ block.settings.muted_color }};
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-{{ ai_gen_id }} {
      padding-right: 16px;
      padding-left: 16px;
    }

    .ai-comparison-{{ ai_gen_id }}__table th,
    .ai-comparison-{{ ai_gen_id }}__table td {
      padding: 14px 12px;
    }
  }
{% endstyle %}

<div class="ai-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-{{ ai_gen_id }}__inner">
    <div class="ai-comparison-{{ ai_gen_id }}__header">
      {% if block.settings.eyebrow != blank %}<p class="ai-comparison-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      <h2 class="ai-comparison-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
      {% if block.settings.intro != blank %}<p class="ai-comparison-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>{% endif %}
    </div>

    <div class="ai-comparison-{{ ai_gen_id }}__table-wrap">
      <table class="ai-comparison-{{ ai_gen_id }}__table">
        <thead>
          <tr>
            <th scope="col">{{ block.settings.benefit_heading | escape }}</th>
            <th scope="col">{{ block.settings.brand_heading | escape }}</th>
            <th scope="col">{{ block.settings.other_heading | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {% for i in (1..6) %}
            {% liquid
              assign benefit_key = 'benefit_' | append: i
              assign benefit = block.settings[benefit_key]
            %}
            <tr>
              <td>{{ benefit | escape }}</td>
              <td><span class="ai-comparison-{{ ai_gen_id }}__mark ai-comparison-{{ ai_gen_id }}__mark--yes" aria-label="Yes">✓</span></td>
              <td><span class="ai-comparison-{{ ai_gen_id }}__mark ai-comparison-{{ ai_gen_id }}__mark--no" aria-label="Not included">—</span></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if block.settings.note != blank %}<p class="ai-comparison-{{ ai_gen_id }}__note">{{ block.settings.note | escape }}</p>{% endif %}
  </div>
</div>

