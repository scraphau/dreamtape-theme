{% doc %}
  @prompt
    add a timeline section with the habit settling, night 1 → week 4
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-habit-timeline-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    /* Named outright for the same reason as the comparison block: neither
       block relies on the theme's font custom properties any more. */
    font-family: 'Inter Tight', system-ui, -apple-system, sans-serif;
    box-sizing: border-box;
  }

  .ai-habit-timeline-{{ ai_gen_id }}__inner {
    max-width: 980px;
    margin: 0 auto;
  }

  .ai-habit-timeline-{{ ai_gen_id }}__header {
    max-width: 640px;
    margin: 0 auto 44px;
    text-align: {{ block.settings.alignment }};
  }

  .ai-habit-timeline-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 12px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-habit-timeline-{{ ai_gen_id }}__title {
    margin: 0 0 14px;
    color: {{ block.settings.heading_color }};
    font-family: 'Fraunces', Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-optical-sizing: auto;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .ai-habit-timeline-{{ ai_gen_id }}__intro {
    margin: 0;
    color: {{ block.settings.muted_color }};
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-habit-timeline-{{ ai_gen_id }}__items {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .ai-habit-timeline-{{ ai_gen_id }}__items::before {
    content: '';
    position: absolute;
    top: 19px;
    right: 10%;
    left: 10%;
    height: 2px;
    background: {{ block.settings.line_color }};
  }

  .ai-habit-timeline-{{ ai_gen_id }}__item {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .ai-habit-timeline-{{ ai_gen_id }}__marker {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: 0 auto 20px;
    border: 2px solid {{ block.settings.accent_color }};
    border-radius: 50%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.accent_color }};
    font-size: 13px;
    font-weight: 700;
  }

  .ai-habit-timeline-{{ ai_gen_id }}__item-title {
    margin: 0 0 9px;
    color: {{ block.settings.heading_color }};
    font-size: 18px;
    line-height: 1.3;
    font-family: 'Fraunces', Georgia, 'Times New Roman', serif;
    font-weight: 500;
    font-optical-sizing: auto;
  }

  .ai-habit-timeline-{{ ai_gen_id }}__item-text {
    margin: 0;
    color: {{ block.settings.muted_color }};
    font-size: 14px;
    line-height: 1.55;
  }

  @media screen and (max-width: 749px) {
    .ai-habit-timeline-{{ ai_gen_id }} {
      padding-right: 20px;
      padding-left: 20px;
    }

    .ai-habit-timeline-{{ ai_gen_id }}__header {
      margin-bottom: 32px;
    }

    .ai-habit-timeline-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-habit-timeline-{{ ai_gen_id }}__items {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .ai-habit-timeline-{{ ai_gen_id }}__items::before {
      top: 20px;
      bottom: 20px;
      left: 19px;
      width: 2px;
      height: auto;
      right: auto;
    }

    .ai-habit-timeline-{{ ai_gen_id }}__item {
      display: grid;
      grid-template-columns: 40px 1fr;
      column-gap: 18px;
      padding-bottom: 28px;
      text-align: left;
    }

    .ai-habit-timeline-{{ ai_gen_id }}__item:last-child {
      padding-bottom: 0;
    }

    .ai-habit-timeline-{{ ai_gen_id }}__marker {
      grid-row: 1 / span 2;
      margin: 0;
    }
  }
{% endstyle %}

<habit-timeline-{{ ai_gen_id }} class="ai-habit-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-habit-timeline-{{ ai_gen_id }}__inner">
    <div class="ai-habit-timeline-{{ ai_gen_id }}__header">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-habit-timeline-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="ai-habit-timeline-{{ ai_gen_id }}__title">{{ block.settings.title }}</h2>
      {% if block.settings.intro != blank %}
        <div class="ai-habit-timeline-{{ ai_gen_id }}__intro">{{ block.settings.intro }}</div>
      {% endif %}
    </div>

    <div class="ai-habit-timeline-{{ ai_gen_id }}__items">
      {% for i in (1..4) %}
        {% liquid
          assign label_key = 'step_' | append: i | append: '_label'
          assign title_key = 'step_' | append: i | append: '_title'
          assign text_key = 'step_' | append: i | append: '_text'
        %}
        <article class="ai-habit-timeline-{{ ai_gen_id }}__item">
          <div class="ai-habit-timeline-{{ ai_gen_id }}__marker" aria-hidden="true">{{ i }}</div>
          <h3 class="ai-habit-timeline-{{ ai_gen_id }}__item-title">{{ block.settings[title_key] }}</h3>
          <p class="ai-habit-timeline-{{ ai_gen_id }}__item-text"><strong>{{ block.settings[label_key] }}</strong><br>{{ block.settings[text_key] }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</habit-timeline-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Habit settling timeline",
  "settings": [
    {"type":"header","content":"Content"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Your journey with mouth tape"},
    {"type":"text","id":"title","label":"Title","default":"A habit that settles in over time"},
    {"type":"textarea","id":"intro","label":"Introduction","default":"Start gently and give your routine time to feel natural. Everyone’s experience is different."},
    {"type":"text","id":"step_1_label","label":"Step 1 label","default":"Night 1"},
    {"type":"text","id":"step_1_title","label":"Step 1 title","default":"Start gently"},
    {"type":"textarea","id":"step_1_text","label":"Step 1 text","default":"Get familiar with the feel and focus on a calm bedtime routine."},
    {"type":"text","id":"step_2_label","label":"Step 2 label","default":"Nights 2–3"},
    {"type":"text","id":"step_2_title","label":"Step 2 title","default":"Find your rhythm"},
    {"type":"textarea","id":"step_2_text","label":"Step 2 text","default":"Your routine begins to feel more familiar as you settle into it."},
    {"type":"text","id":"step_3_label","label":"Step 3 label","default":"Week 2"},
    {"type":"text","id":"step_3_title","label":"Step 3 title","default":"Build consistency"},
    {"type":"textarea","id":"step_3_text","label":"Step 3 text","default":"Keep your evening routine consistent and notice how it feels for you."},
    {"type":"text","id":"step_4_label","label":"Step 4 label","default":"Week 4"},
    {"type":"text","id":"step_4_title","label":"Step 4 title","default":"Feel settled"},
    {"type":"textarea","id":"step_4_text","label":"Step 4 text","default":"By now, the habit can feel like a natural part of winding down."},
    {"type":"header","content":"Layout"},
    {"type":"select","id":"alignment","label":"Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"vertical_padding","label":"Vertical spacing","min":20,"max":100,"step":5,"unit":"px","default":60},
    {"type":"range","id":"heading_size","label":"Heading size","min":24,"max":60,"step":2,"unit":"px","default":38},
    {"type":"header","content":"Colors"},
    {"type":"color","id":"background_color","label":"Background","default":"#f3f6fb"},
    {"type":"color","id":"heading_color","label":"Headings","default":"#0e1a3a"},
    {"type":"color","id":"text_color","label":"Text","default":"#0a1432"},
    {"type":"color","id":"muted_color","label":"Supporting text","default":"#5a6580"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#0e1a3a"},
    {"type":"color","id":"line_color","label":"Timeline line","default":"#b8c3d8"}
  ],
  "presets": [{"name":"Habit settling timeline"}],
  "tag": null,
  "class": "habit-settling-timeline-block"
}
{% endschema %}