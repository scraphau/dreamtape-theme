<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_midnight }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- comment -%}
      Whitespace-stripped on every tag: the title was reaching the browser with
      a newline in the middle of it, which search results render as a space in
      an odd place and which makes the tag harder to read in any tool.
    {%- endcomment -%}
    <title>
      {{- page_title -}}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}
    {% render 'structured-data' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Inter+Tight:wght@300;400;500;600;700&display=swap">

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      base.css is a plain .css asset, so Shopify never runs Liquid inside it -
      the colour settings have to be emitted here to reach the browser at all.
      These override the defaults baked into base.css's :root block.
    {%- endcomment -%}
    <style>
      :root {
        --midnight: {{ settings.color_midnight | default: '#0e1a3a' }};
        --midnight-2: {{ settings.color_midnight_2 | default: '#1b2d5a' }};
        --midnight-deep: {{ settings.color_midnight_deep | default: '#07102a' }};
        --cream: {{ settings.color_cream | default: '#ffffff' }};
        --cream-warm: {{ settings.color_light_background | default: '#f3f6fb' }};
        --paper: {{ settings.color_paper | default: '#ffffff' }};
        --gold: {{ settings.color_gold | default: '#ffffff' }};
        --gold-deep: {{ settings.color_accent | default: '#0e1a3a' }};
        --ink: {{ settings.color_text | default: '#0a1432' }};
        --muted: {{ settings.color_muted | default: '#5a6580' }};
      }
    </style>
  </head>

  <body class="template-{{ template | replace: '.', '-' | handle }}">
    <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script>
      window.themeRoutes = {
        cartAddUrl: {{ routes.cart_add_url | json }},
        cartUrl: {{ routes.cart_url | json }},
        cartChangeUrl: {{ routes.cart_change_url | json }},
        cartUpdateUrl: {{ routes.cart_update_url | json }},
        cartCurrency: {{ cart.currency.iso_code | json }},
        {%- comment -%}
          The shop's own currency formatting, so prices the theme renders in
          JavaScript come out the same as the ones Liquid renders. Without it
          the two disagree: Intl formats by the reader's browser language, so
          an American browser writes AUD as "A$210" on a page where Liquid has
          already written "$210".
        {%- endcomment -%}
        moneyFormat: {{ shop.money_format | json }}
      };
      {%- comment -%} null when the shop has no shipping-protection product, which turns the sync in theme.js off. {%- endcomment -%}
      window.themeShippingProtectionVariantId = {{ all_products['shipping-protection'].variants.first.id | json }};
    </script>
    {%- comment -%} Static section: no preset needed, no JSON template touched. {%- endcomment -%}
    {% section 'newsletter-popup' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
