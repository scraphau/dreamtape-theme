<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_midnight }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Inter+Tight:wght@300;400;500;600;700&display=swap">

    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- comment -%} Same reason as theme.liquid: base.css is a plain asset, so Liquid never runs inside it. {%- endcomment -%}
    <style>
      :root {
        --midnight: {{ settings.color_midnight | default: '#0e1a3a' }};
        --midnight-2: {{ settings.color_midnight_2 | default: '#1b2d5a' }};
        --midnight-deep: {{ settings.color_midnight_deep | default: '#07102a' }};
        --cream: {{ settings.color_cream | default: '#ffffff' }};
        --cream-warm: {{ settings.color_light_background | default: '#f3f6fb' }};
        --paper: {{ settings.color_paper | default: '#ffffff' }};
        --gold: {{ settings.color_gold | default: '#ffffff' }};
        --gold-deep: {{ settings.color_accent | default: '#0e1a3a' }};
        --ink: {{ settings.color_text | default: '#0a1432' }};
        --muted: {{ settings.color_muted | default: '#5a6580' }};
      }
    </style>
  </head>

  <body class="template-password">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
