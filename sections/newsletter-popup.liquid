{%- comment -%}
  Email capture popup.

  Rendered statically from theme.liquid with a section tag, not added to a JSON
  template. It therefore needs no preset and touches no template file, so the
  home page cannot be affected by it.

  Uses Shopify's own customer form, so addresses land in Customers as marketing
  contacts with no app involved.
{%- endcomment -%}
{%- if section.settings.enabled -%}
  <div
    class="np-overlay"
    data-newsletter-popup
    data-delay="{{ section.settings.delay | default: 8 }}"
    data-days="{{ section.settings.remind_days | default: 30 }}"
    hidden
  >
    <div class="np-modal" role="dialog" aria-modal="true" aria-labelledby="np-title" style="{% render 'section-color-vars', section: section %}">
      <button type="button" class="np-close" data-np-close aria-label="Close">&times;</button>

      {%- if section.settings.eyebrow != blank -%}
        <span class="np-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- form 'customer', class: 'np-form' -%}
        {%- if form.posted_successfully? -%}
          <h2 id="np-title" class="np-title">{{ section.settings.success_heading }}</h2>
          <p class="np-text">{{ section.settings.success_body }}</p>
          {%- if section.settings.discount_code != blank -%}
            <p class="np-code">{{ section.settings.discount_code }}</p>
          {%- endif -%}
          <button type="button" class="btn-primary btn-dark btn-full" data-np-close>{{ section.settings.success_button }}</button>
        {%- else -%}
          <h2 id="np-title" class="np-title">{{ section.settings.heading }}</h2>
          {%- if section.settings.body != blank -%}
            <p class="np-text">{{ section.settings.body }}</p>
          {%- endif -%}

          <input type="hidden" name="contact[tags]" value="{{ section.settings.tags }}">
          <label class="visually-hidden" for="np-email">Email</label>
          <input
            type="email"
            id="np-email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder }}"
            autocomplete="email"
            required
          >
          <button type="submit" class="btn-primary btn-dark btn-full">{{ section.settings.button_text }}</button>

          {%- if form.errors -%}
            <p class="np-error">{{ form.errors.messages['email'] | default: 'That email address does not look right.' }}</p>
          {%- endif -%}

          {%- if section.settings.decline_text != blank -%}
            <button type="button" class="np-decline" data-np-close>{{ section.settings.decline_text }}</button>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.fine_print != blank -%}
        <p class="np-fine">{{ section.settings.fine_print }}</p>
      {%- endif -%}
    </div>
  </div>

  <script>
    // Self-contained and guarded: if anything here throws, the popup simply
    // never opens. It is hidden in the markup, so a failure costs the popup,
    // never the page.
    (function () {
      try {
        var overlay = document.querySelector('[data-newsletter-popup]');
        if (!overlay) return;

        // Never in the theme editor - it would cover the thing being edited.
        if (window.Shopify && window.Shopify.designMode) return;

        var SEEN = 'dt_np_seen';
        var DONE = 'dt_np_signed';
        var days = parseInt(overlay.dataset.days, 10) || 30;
        var delay = (parseInt(overlay.dataset.delay, 10) || 8) * 1000;
        var opener = null;

        function store(key) {
          try { return window.localStorage.getItem(key); } catch (e) { return null; }
        }
        function remember(key, value) {
          try { window.localStorage.setItem(key, value); } catch (e) {}
        }

        function suppressed() {
          if (store(DONE)) return true;
          var seen = parseInt(store(SEEN), 10);
          if (!seen) return false;
          return (Date.now() - seen) < days * 86400000;
        }

        function open() {
          if (!overlay.hidden) return;
          opener = document.activeElement;
          overlay.hidden = false;
          document.documentElement.classList.add('np-open');
          var close = overlay.querySelector('[data-np-close]');
          if (close) close.focus();
        }

        function close() {
          overlay.hidden = true;
          document.documentElement.classList.remove('np-open');
          remember(SEEN, String(Date.now()));
          if (opener && opener.focus) opener.focus();
        }

        overlay.addEventListener('click', function (e) {
          if (e.target === overlay || e.target.closest('[data-np-close]')) close();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !overlay.hidden) close();
        });

        // Signed up: Shopify reloads with this flag, so show the code and
        // never ask again.
        if (window.location.search.indexOf('customer_posted=true') !== -1) {
          remember(DONE, '1');
          open();
          return;
        }

        if (suppressed()) return;

        var timer = setTimeout(open, delay);

        // Leaving toward the tab bar - last chance, desktop only.
        document.addEventListener('mouseout', function (e) {
          if (!e.relatedTarget && e.clientY <= 0 && window.innerWidth > 768) {
            clearTimeout(timer);
            open();
          }
        });
      } catch (e) {
        /* popup stays closed */
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter popup",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show the popup", "default": true },
    { "type": "range", "id": "delay", "min": 2, "max": 30, "step": 1, "unit": "s", "label": "Show after", "default": 8 },
    { "type": "range", "id": "remind_days", "min": 1, "max": 90, "step": 1, "unit": "d", "label": "Do not ask again for", "default": 30 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0e1a3a" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text color", "default": "#5a6580" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#0e1a3a" },
    { "type": "color", "id": "card_background_color", "label": "Card background color", "default": "#ffffff" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you go" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10% off your first order." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Join the list for 10% off, plus the occasional note on sleep worth reading. No spam, unsubscribe anytime." },
    { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "your@email.com" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Send my code" },
    { "type": "text", "id": "decline_text", "label": "Decline link", "default": "No thanks, I sleep fine" },
    { "type": "text", "id": "tags", "label": "Tag added to the contact", "info": "Lets you find these signups later in Customers.", "default": "newsletter,popup" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "One use per customer. Not valid with subscription discounts." },
    { "type": "header", "content": "After signup" },
    { "type": "text", "id": "success_heading", "label": "Heading", "default": "You are on the list." },
    { "type": "textarea", "id": "success_body", "label": "Body", "default": "Here is your code, and it is on its way to your inbox too." },
    { "type": "text", "id": "discount_code", "label": "Discount code", "info": "Create this code in Discounts first. Leave blank to show no code.", "default": "SLEEP10" },
    { "type": "text", "id": "success_button", "label": "Button text", "default": "Start shopping" }
  ]
}
{% endschema %}
