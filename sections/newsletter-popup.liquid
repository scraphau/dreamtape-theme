{%- comment -%}
  Email capture popup, plus the small tab it collapses into.

  Rendered statically from theme.liquid with a section tag, not added to a JSON
  template. It therefore needs no preset and touches no template file, so the
  home page cannot be affected by it.

  Behaviour: the popup opens once. Closing it - by any route - collapses it to a
  tab in the bottom left, which reopens it on click. Dismissing that tab ends it
  for good. Signing up ends it for good. Nothing reopens on its own.

  Uses Shopify's own customer form, so addresses land in Customers as marketing
  contacts with no app involved.
{%- endcomment -%}
{%- if section.settings.enabled -%}
  <div
    class="np-overlay"
    data-newsletter-popup
    data-delay="{{ section.settings.delay | default: 5 }}"
    hidden
  >
    <div class="np-modal" role="dialog" aria-modal="true" aria-labelledby="np-title" style="--np-bg: {{ section.settings.modal_background | default: '#1b2d5a' }}; --np-text: {{ section.settings.modal_text | default: '#ffffff' }}; --np-btn: {{ section.settings.button_background | default: '#dbe5f6' }}; --np-btn-text: {{ section.settings.button_text_color | default: '#0e1a3a' }};">
      <button type="button" class="np-close" data-np-close aria-label="Close">&times;</button>

      {%- if section.settings.eyebrow != blank -%}
        <span class="np-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- form 'customer', class: 'np-form' -%}
        {%- if form.posted_successfully? -%}
          <h2 id="np-title" class="np-title">{{ section.settings.success_heading }}</h2>
          <p class="np-text">{{ section.settings.success_body }}</p>
          {%- if section.settings.discount_code != blank -%}
            <p class="np-code">{{ section.settings.discount_code }}</p>
          {%- endif -%}
          <button type="button" class="np-submit" data-np-close>{{ section.settings.success_button }}</button>
        {%- else -%}
          <h2 id="np-title" class="np-title">{{ section.settings.heading }}</h2>
          {%- if section.settings.body != blank -%}
            <p class="np-text">{{ section.settings.body }}</p>
          {%- endif -%}

          <input type="hidden" name="contact[tags]" value="{{ section.settings.tags }}">
          <label class="visually-hidden" for="np-email">Email</label>
          <input
            type="email"
            id="np-email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder }}"
            autocomplete="email"
            required
          >
          <button type="submit" class="np-submit">{{ section.settings.button_text }}</button>

          {%- if form.errors -%}
            <p class="np-error">{{ form.errors.messages['email'] | default: 'That email address does not look right.' }}</p>
          {%- endif -%}

          {%- if section.settings.decline_text != blank -%}
            <button type="button" class="np-decline" data-np-close>{{ section.settings.decline_text }}</button>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.fine_print != blank -%}
        <p class="np-fine">{{ section.settings.fine_print }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%}
    What the popup collapses into. Two separate buttons rather than one nested
    inside another: reopening and dismissing for good are different decisions
    and each needs its own hit area.
  {%- endcomment -%}
  <div class="np-tab" data-np-tab hidden>
    <button type="button" class="np-tab-open" data-np-tab-open>
      {%- if section.settings.tab_icon != blank -%}
        <span class="np-tab-icon" aria-hidden="true">{{ section.settings.tab_icon }}</span>
      {%- endif -%}
      <span>{{ section.settings.tab_text }}</span>
    </button>
    <button type="button" class="np-tab-close" data-np-tab-dismiss aria-label="{{ section.settings.tab_dismiss_label }}">&times;</button>
  </div>

  <script>
    // Self-contained and guarded: if anything here throws, neither the popup
    // nor the tab ever opens. Both ship hidden, so a failure costs the offer,
    // never the page.
    (function () {
      try {
        var overlay = document.querySelector('[data-newsletter-popup]');
        var tab = document.querySelector('[data-np-tab]');
        if (!overlay) return;

        // ?popup=1 forces it open and ignores every suppression rule. Once a
        // visitor has seen or dismissed this, nothing brings it back on its
        // own - by design - which makes it impossible to check your own work
        // without clearing site data. This is the way back in.
        var force = window.location.search.indexOf('popup=1') !== -1;

        // In the theme editor, open it every time and record nothing. Bailing
        // out here is why it looked like nothing was happening while editing.
        var inEditor = !!(window.Shopify && window.Shopify.designMode);

        var SHOWN = 'dt_np_shown';      // popup has had its one automatic opening
        var DISMISSED = 'dt_np_done';   // tab dismissed, or signed up - over for good
        var delay = (parseInt(overlay.dataset.delay, 10) || 5) * 1000;
        var opener = null;

        function store(key) {
          try { return window.localStorage.getItem(key); } catch (e) { return null; }
        }
        function remember(key) {
          try { window.localStorage.setItem(key, '1'); } catch (e) {}
        }

        function showTab() {
          if (tab) tab.hidden = false;
        }
        function hideTab() {
          if (tab) tab.hidden = true;
        }

        function openPopup(persist) {
          if (!overlay.hidden) return;
          opener = document.activeElement;
          overlay.hidden = false;
          hideTab();
          document.documentElement.classList.add('np-open');
          if (persist !== false) remember(SHOWN);
          var close = overlay.querySelector('[data-np-close]');
          if (close) close.focus();
        }

        // Closing never ends it - it collapses to the tab, which is the only
        // thing that reopens the popup from here on.
        function closePopup() {
          overlay.hidden = true;
          document.documentElement.classList.remove('np-open');
          showTab();
          if (opener && opener.focus) opener.focus();
        }

        function endForGood() {
          overlay.hidden = true;
          document.documentElement.classList.remove('np-open');
          hideTab();
          remember(DISMISSED);
        }

        overlay.addEventListener('click', function (e) {
          if (e.target === overlay || e.target.closest('[data-np-close]')) closePopup();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !overlay.hidden) closePopup();
        });
        if (tab) {
          tab.addEventListener('click', function (e) {
            if (e.target.closest('[data-np-tab-dismiss]')) return endForGood();
            if (e.target.closest('[data-np-tab-open]')) openPopup();
          });
        }

        // Signed up: Shopify reloads with this flag. Show the code once, and
        // that is the end of it.
        if (window.location.search.indexOf('customer_posted=true') !== -1) {
          remember(DISMISSED);
          overlay.hidden = false;
          document.documentElement.classList.add('np-open');
          hideTab();
          overlay.addEventListener('click', hideTab);
          return;
        }

        // Straight open, no delay, nothing recorded - so a preview does not
        // count as the visitor's one showing.
        if (force || inEditor) return openPopup(false);

        if (store(DISMISSED)) return;

        // Already had its opening on an earlier page - tab only, no interruption.
        if (store(SHOWN)) return showTab();

        var timer = setTimeout(openPopup, delay);

        // Leaving toward the tab bar - last chance, desktop only.
        document.addEventListener('mouseout', function (e) {
          if (!e.relatedTarget && e.clientY <= 0 && window.innerWidth > 768) {
            clearTimeout(timer);
            openPopup();
          }
        });
      } catch (e) {
        /* popup and tab stay closed */
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter popup",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show the popup", "default": true },
    { "type": "range", "id": "delay", "min": 2, "max": 30, "step": 1, "unit": "s", "label": "Show after", "default": 5 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "modal_background", "label": "Popup background", "default": "#1b2d5a" },
    { "type": "color", "id": "modal_text", "label": "Popup text", "default": "#ffffff" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#dbe5f6" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#0e1a3a" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sleep Better. Live Better." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Unlock 10% Off Your First Order" },
    { "type": "textarea", "id": "body", "label": "Body", "info": "Leave blank for the tighter layout.", "default": "" },
    { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "GET MY 10% OFF" },
    { "type": "text", "id": "decline_text", "label": "Decline link", "info": "Blank hides it - the X still closes the popup.", "default": "" },
    { "type": "text", "id": "tags", "label": "Tag added to the contact", "info": "Lets you find these signups later in Customers.", "default": "newsletter,popup" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "One use per customer. Not valid with subscription discounts." },
    { "type": "header", "content": "Collapsed tab", "info": "Shown in the bottom left after the popup is closed. Dismissing it stops both for good." },
    { "type": "text", "id": "tab_icon", "label": "Tab icon", "default": "🎁" },
    { "type": "text", "id": "tab_text", "label": "Tab text", "default": "10% off your first order" },
    { "type": "text", "id": "tab_dismiss_label", "label": "Tab dismiss button label", "info": "Read out by screen readers.", "default": "Dismiss this offer" },
    { "type": "header", "content": "After signup" },
    { "type": "text", "id": "success_heading", "label": "Heading", "default": "You are on the list." },
    { "type": "textarea", "id": "success_body", "label": "Body", "default": "Here is your code, and it is on its way to your inbox too." },
    { "type": "text", "id": "discount_code", "label": "Discount code", "info": "Create this code in Discounts first. Leave blank to show no code.", "default": "SLEEP10" },
    { "type": "text", "id": "success_button", "label": "Button text", "default": "Start shopping" }
  ],
  "presets": [
    { "name": "Newsletter popup" }
  ]
}
{% endschema %}
