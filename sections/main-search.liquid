{%- comment -%}
  Search results. This template used to load main-collection, which loops
  collection.products - always empty here - so every search rendered a blank
  heading over "No products in this collection yet."

  Searches products, pages and articles together; the theme has few products,
  so a query that only matches an FAQ or a policy page should still find it.
{%- endcomment -%}
<section class="search-page" style="{% render 'section-color-vars', section: section %}">
  <div class="container">

    <div class="search-header">
      <h1>
        {%- if search.performed -%}
          {{ section.settings.heading_results }}
        {%- else -%}
          {{ section.settings.heading_empty }}
        {%- endif -%}
      </h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <label class="visually-hidden" for="search-input">{{ 'general.search.placeholder' | t }}</label>
        <input
          type="search"
          id="search-input"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
        >
        <button type="submit">{{ 'general.search.submit' | t }}</button>
      </form>

      {%- if search.performed -%}
        <p class="search-count">
          {%- if search.results_count == 0 -%}
            No results for &ldquo;{{ search.terms | escape }}&rdquo;
          {%- elsif search.results_count == 1 -%}
            1 result for &ldquo;{{ search.terms | escape }}&rdquo;
          {%- else -%}
            {{ search.results_count }} results for &ldquo;{{ search.terms | escape }}&rdquo;
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}

        <div class="search-empty">
          <p>{{ section.settings.no_results_text }}</p>
          <a href="{{ routes.root_url }}" class="btn-primary btn-dark">Back to home</a>
        </div>

      {%- else -%}

        {%- paginate search.results by 24 -%}
          {%- comment -%} Products render as cards; everything else as a text result. {%- endcomment -%}
          {%- assign product_results = search.results | where: 'object_type', 'product' -%}
          {%- if product_results.size > 0 -%}
            <div class="product-grid">
              {%- for item in product_results -%}
                {%- render 'product-card', product: item -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- assign page_result_count = 0 -%}
          {%- for item in search.results -%}
            {%- unless item.object_type == 'product' -%}
              {%- assign page_result_count = page_result_count | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}

          {%- if page_result_count > 0 -%}
            <div class="search-pages">
              <h2 class="search-pages-title">Pages &amp; articles</h2>
              <ul>
                {%- for item in search.results -%}
                  {%- unless item.object_type == 'product' -%}
                    <li>
                      <a href="{{ item.url }}">{{ item.title }}</a>
                      {%- if item.content != blank -%}
                        <p>{{ item.content | strip_html | truncatewords: 28 }}</p>
                      {%- endif -%}
                    </li>
                  {%- endunless -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            <nav class="search-pagination" aria-label="Pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}">&larr; {{ 'general.pagination.previous' | t }}</a>
              {%- endif -%}
              <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }} &rarr;</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}

      {%- endif -%}
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0e1a3a" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text color", "default": "#5a6580" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#0e1a3a" },
    { "type": "color", "id": "card_background_color", "label": "Card background color", "default": "#ffffff" },
    { "type": "text", "id": "heading_results", "label": "Heading (after searching)", "default": "Search results" },
    { "type": "text", "id": "heading_empty", "label": "Heading (before searching)", "default": "Search" },
    { "type": "textarea", "id": "no_results_text", "label": "No results text", "default": "Nothing matched that. Try a shorter phrase, or check the FAQ - most questions about how the tape works are answered there." }
  ]
}
{% endschema %}
