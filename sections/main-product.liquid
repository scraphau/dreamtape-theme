{{ 'loop-widget.css' | asset_url | stylesheet_tag }}
{{ 'loop-widget-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'loop-widget.js' | asset_url }}" defer></script>

<section id="product-form" class="product-page" style="{% render 'section-color-vars', section: section %}">
  <div class="container">
    <div class="product-layout">

      <!-- Gallery -->
      <div class="product-gallery">
        <div class="product-gallery-main" data-gallery-main>
          {%- if product.media.size > 0 -%}
            <div class="gallery-track" data-gallery-track>
              {%- for media in product.media -%}
                <div class="gallery-slide">
                  <img src="{{ media | image_url: width: 1600 }}" alt="{{ media.alt | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="product-gallery-placeholder">
              <div class="pgp-inner">
                <span class="pgp-moon">◐</span>
                <p class="pgp-name">{{ product.title }}</p>
                <span class="pgp-note">Product image coming soon</span>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.image_badge != blank -%}
            <div class="gallery-badge">{{ section.settings.image_badge }}</div>
          {%- endif -%}

          {%- if product.media.size > 1 -%}
            <button type="button" class="gallery-arrow gallery-arrow--prev" data-gallery-prev aria-label="Previous image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button type="button" class="gallery-arrow gallery-arrow--next" data-gallery-next aria-label="Next image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-thumbs">
            {%- for media in product.media -%}
              <div class="product-thumb {% if forloop.first %}active{% endif %}" data-gallery-thumb>
                <img src="{{ media | image_url: width: 200 }}" alt="">
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- assign gallery_faq_blocks = section.blocks | where: 'type', 'gallery_faq' -%}
        {%- if gallery_faq_blocks.size > 0 -%}
          <div class="gallery-faq" data-gallery-faq>
            {%- for block in gallery_faq_blocks -%}
              <div class="gallery-faq-item" {{ block.shopify_attributes }}>
                <button type="button" class="gallery-faq-summary" aria-expanded="false">
                  <span class="gallery-faq-icon">{% render 'icon-line', icon: block.settings.icon %}</span>
                  <span class="gallery-faq-question">{{ block.settings.question }}</span>
                  <span class="gallery-faq-chevron" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </button>
                <div class="gallery-faq-body">
                  <div class="gallery-faq-answer">{{ block.settings.answer }}</div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Info -->
      <div class="product-info">

        <!-- Rating -->
        <div class="product-rating-row">
          <span class="product-stars">★★★★★</span>
          <span class="product-rating-count">
            {%- if product.metafields.reviews.rating_count.value != blank -%}
              {{ product.metafields.reviews.rating.value }} ({{ product.metafields.reviews.rating_count.value }} reviews)
            {%- else -%}
              {{ section.settings.rating_text }}
            {%- endif -%}
          </span>
          {%- if section.settings.badge_text != blank -%}
            <span class="product-award-badge">{{ section.settings.badge_text }}</span>
          {%- endif -%}
        </div>

        <h1 class="product-title">{{ product.title }}</h1>

        {%- if section.settings.tagline != blank -%}
          <p class="product-tagline">{{ section.settings.tagline }}</p>
        {%- elsif product.metafields.custom.tagline.value != blank -%}
          <p class="product-tagline">{{ product.metafields.custom.tagline.value }}</p>
        {%- endif -%}

        {%- if section.settings.bullets != blank -%}
          <ul class="product-bullets">
            {%- assign bullets = section.settings.bullets | newline_to_br | split: '<br />' -%}
            {%- for bullet in bullets -%}
              {%- if bullet != blank -%}<li>{{ bullet }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- form 'product', product, id: 'product-add-form' -%}

          {%- assign first_sub_discount_percent = 0 -%}

          {%- if product.variants.size > 1 -%}

            {%- assign base_price = 0 -%}
            {%- assign three_month_variant = blank -%}
            {%- for v in product.variants -%}
              {%- unless v.title contains '3' or v.title contains 'Three' or v.title contains '6' or v.title contains 'Six' -%}
                {%- assign base_price = v.price -%}
              {%- endunless -%}
              {%- if v.title contains '3' or v.title contains 'Three' -%}
                {%- if three_month_variant == blank -%}
                  {%- assign three_month_variant = v -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            <!-- Price row -->
            <div class="product-price-row">
              {%- comment -%} Land on the 3-month pack by default so every internal link into this page opens on the 3-month subscription, unless the URL explicitly selects a different variant. {%- endcomment -%}
              {%- assign first = product.selected_variant | default: three_month_variant | default: product.selected_or_first_available_variant -%}

              {%- assign first_packs = 1 -%}
              {%- if first.title contains '3' or first.title contains 'Three' -%}
                {%- assign first_packs = 3 -%}
              {%- elsif first.title contains '6' or first.title contains 'Six' -%}
                {%- assign first_packs = 6 -%}
              {%- endif -%}
              {%- assign first_implied_compare = base_price | times: first_packs -%}
              {%- assign first_effective_compare = first.compare_at_price -%}
              {%- if first_effective_compare <= first.price and first_implied_compare > first.price -%}
                {%- assign first_effective_compare = first_implied_compare -%}
              {%- endif -%}

              <span class="product-price-compare" data-compare-price {% unless first_effective_compare > first.price %}style="display:none;"{% endunless %}>{{ first_effective_compare | money_without_trailing_zeros }}</span>
              <span class="product-price-current {% if first_effective_compare > first.price %}is-discounted{% endif %}" data-current-price>{{ first.price | money_without_trailing_zeros }}</span>
              {%- assign first_discount_percent = 0 -%}
              {%- if first_effective_compare > first.price -%}
                {%- assign first_saved = first_effective_compare | minus: first.price -%}
                {%- assign first_discount_percent = first_saved | times: 100 | divided_by: first_effective_compare -%}
                {%- assign first_discount_percent = first_discount_percent | divided_by: 5 | times: 5 -%}
              {%- endif -%}
              <span class="product-price-pill" data-price-pill {% if first_discount_percent == 0 %}style="display:none;"{% endif %}>{{ first_discount_percent }}% off</span>
            </div>

            <input type="hidden" name="id" value="{{ first.id }}" data-variant-input>

            <div class="variant-picker">
              <div class="variant-picker-divider"><span>Choose your supply</span></div>

              <div class="variant-options-stack" data-variant-picker>
                {%- for variant in product.variants -%}
                  {%- assign packs = 1 -%}
                  {%- assign months = 1 -%}
                  {%- if variant.title contains '3' or variant.title contains 'Three' -%}
                    {%- assign packs = 3 -%}
                    {%- assign months = 3 -%}
                  {%- elsif variant.title contains '6' or variant.title contains 'Six' -%}
                    {%- assign packs = 6 -%}
                    {%- assign months = 6 -%}
                  {%- endif -%}
                  {%- assign strips = packs | times: 30 -%}
                  {%- assign per_strip = variant.price | divided_by: strips -%}

                  {%- assign is_popular = false -%}
                  {%- assign is_deal = false -%}
                  {%- if variant.title contains '3' or variant.title contains 'Three' -%}
                    {%- assign is_popular = true -%}
                  {%- elsif variant.title contains '6' or variant.title contains 'Six' -%}
                    {%- assign is_deal = true -%}
                  {%- endif -%}

                  {%- assign implied_compare = base_price | times: packs -%}
                  {%- assign effective_compare = variant.compare_at_price -%}
                  {%- if effective_compare <= variant.price and implied_compare > variant.price -%}
                    {%- assign effective_compare = implied_compare -%}
                  {%- endif -%}

                  {%- assign discount_percent = 0 -%}
                  {%- if effective_compare > variant.price -%}
                    {%- assign saved_amount = effective_compare | minus: variant.price -%}
                    {%- assign discount_percent = saved_amount | times: 100 | divided_by: effective_compare -%}
                    {%- comment -%} Round down to the nearest 5 so a slightly-off dollar amount still shows a clean marketing number (never overstates the actual discount). {%- endcomment -%}
                    {%- assign discount_percent = discount_percent | divided_by: 5 | times: 5 -%}
                  {%- endif -%}

                  {%- comment -%}
                    Match the selling plan tier to this pack size (e.g. "every 3
                    months" plan for the 3-month pack) rather than always taking
                    the first available plan.

                    Matched against the plan's option values as well as its name,
                    with hyphens flattened to spaces: a plan called "6-month
                    subscription", or one whose name carries no interval at all
                    and only says "Delivery every / 6 Months" in its options,
                    both used to miss the plain "6 month" test and drop through
                    to the fallback below - which is the cheapest plan in the
                    group, usually the monthly one. That put a 6 month supply on
                    a 1 month refill.
                  {%- endcomment -%}
                  {%- assign matched_allocation = blank -%}
                  {%- for alloc in variant.selling_plan_allocations -%}
                    {%- assign plan_haystack = alloc.selling_plan.name -%}
                    {%- for plan_option in alloc.selling_plan.options -%}
                      {%- assign plan_haystack = plan_haystack | append: ' ' | append: plan_option.value -%}
                    {%- endfor -%}
                    {%- assign plan_name = plan_haystack | downcase | replace: '-', ' ' | replace: '_', ' ' -%}
                    {%- assign is_match = false -%}
                    {%- if packs == 3 and plan_name contains '3 month' -%}
                      {%- assign is_match = true -%}
                    {%- elsif packs == 6 and plan_name contains '6 month' -%}
                      {%- assign is_match = true -%}
                    {%- elsif packs == 1 and plan_name contains 'month' -%}
                      {%- unless plan_name contains '3 month' or plan_name contains '6 month' -%}
                        {%- assign is_match = true -%}
                      {%- endunless -%}
                    {%- endif -%}
                    {%- if is_match and matched_allocation == blank -%}
                      {%- assign matched_allocation = alloc -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if matched_allocation == blank -%}
                    {%- assign matched_allocation = variant.selling_plan_allocations.first -%}
                  {%- endif -%}

                  {%- comment -%} Read the intended percentage straight from the plan name (e.g. "...10% off") so it's exact, since deriving it from real dollar amounts can be off by a point due to rounding. Strips common punctuation in case the number isn't cleanly space-separated. {%- endcomment -%}
                  {%- assign name_percent = 0 -%}
                  {%- if matched_allocation -%}
                    {%- assign plan_name_lower = matched_allocation.selling_plan.name | downcase -%}
                    {%- if plan_name_lower contains '%' -%}
                      {%- assign before_percent = plan_name_lower | split: '%' | first -%}
                      {%- assign before_percent = before_percent | replace: ',', ' ' | replace: '(', ' ' | replace: ')', ' ' -%}
                      {%- assign name_words = before_percent | split: ' ' -%}
                      {%- assign name_words = name_words | reverse -%}
                      {%- for word in name_words -%}
                        {%- assign word_number = word | times: 1 -%}
                        {%- if word != '' and word_number > 0 and name_percent == 0 -%}
                          {%- assign name_percent = word_number -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endif -%}

                  {%- comment -%}
                    Always show Shopify's own computed selling_plan_allocation.price
                    as the subscribe price, since that's exactly what checkout
                    charges. Deriving a separate number from a percentage off the
                    "compare at" price could drift from the real charge whenever
                    the plan's percentage doesn't line up with that basis exactly
                    (e.g. a 30%-off plan applied to variant.price landing on a
                    different dollar figure than 30% off the implied original
                    price) - so it's only ever used to label the discount, never
                    to compute the price itself.
                  {%- endcomment -%}
                  {%- assign selling_plan_id = '' -%}
                  {%- assign sub_price = '' -%}
                  {%- assign sub_compare = '' -%}
                  {%- assign sub_discount_percent = 0 -%}
                  {%- assign sub_price_cents = 0 -%}
                  {%- if matched_allocation -%}
                    {%- assign selling_plan_id = matched_allocation.selling_plan.id -%}
                    {%- assign sub_compare_basis = variant.price -%}
                    {%- if effective_compare > matched_allocation.price -%}
                      {%- assign sub_compare_basis = effective_compare -%}
                    {%- endif -%}
                    {%- assign sub_price = matched_allocation.price | money_without_trailing_zeros -%}
                    {%- assign sub_compare = sub_compare_basis | money_without_trailing_zeros -%}
                    {%- if matched_allocation.price < sub_compare_basis -%}
                      {%- assign sub_saved = sub_compare_basis | minus: matched_allocation.price -%}
                      {%- assign sub_discount_percent = sub_saved | times: 100 | divided_by: sub_compare_basis -%}
                    {%- endif -%}
                    {%- assign sub_price_cents = matched_allocation.price -%}
                  {%- endif -%}

                  {%- assign sub_per_strip = '' -%}
                  {%- if sub_price_cents > 0 -%}
                    {%- assign sub_per_strip = sub_price_cents | divided_by: strips | money -%}
                  {%- endif -%}
                  {%- if name_percent > 0 -%}
                    {%- assign sub_discount_percent = name_percent -%}
                  {%- else -%}
                    {%- comment -%} No literal percentage in the plan name (e.g. fixed-price plan) - round down to the nearest 5 so a slightly-off dollar amount still shows a clean number. {%- endcomment -%}
                    {%- assign sub_discount_percent = sub_discount_percent | divided_by: 5 | times: 5 -%}
                  {%- endif -%}
                  {%- if variant.id == first.id -%}
                    {%- assign first_sub_discount_percent = sub_discount_percent -%}
                  {%- endif -%}

                  <button type="button"
                    class="variant-card {% if variant.id == first.id %}active{% endif %} {% if is_popular %}variant-card--popular{% elsif is_deal %}variant-card--deal{% endif %}"
                    data-variant-id="{{ variant.id }}"
                    data-price="{{ variant.price | money_without_trailing_zeros }}"
                    data-compare="{{ effective_compare | money_without_trailing_zeros }}"
                    data-discount="{{ discount_percent }}"
                    data-sub-price="{{ sub_price }}"
                    data-sub-compare="{{ sub_compare }}"
                    data-sub-discount="{{ sub_discount_percent }}"
                    data-per-strip="{{ per_strip | money }}"
                    data-sub-per-strip="{{ sub_per_strip }}"
                    data-selling-plan-id="{{ selling_plan_id }}">

                    {%- if is_popular -%}
                      <span class="vc-ribbon">Most Popular</span>
                    {%- elsif is_deal -%}
                      <span class="vc-ribbon">Best Deal</span>
                    {%- endif -%}

                    <div class="vc-select">
                      <span class="vc-radio"></span>
                    </div>

                    <div class="vc-body">
                      <div class="vc-top">
                        <span class="vc-title">{{ months }} Month Supply</span>
                        <span class="vc-pill" data-vc-pill {% if discount_percent == 0 %}style="display:none;"{% endif %}>{{ discount_percent }}% off</span>
                      </div>
                      <span class="vc-meta vc-meta--italic">{{ packs }} x 30 Strips</span>
                      <span class="vc-shipping" data-vc-shipping>FREE Shipping</span>
                    </div>

                    <div class="vc-pricing">
                      <span class="vc-price-row">
                        <span class="vc-price" data-vc-price>{{ variant.price | money_without_trailing_zeros }}</span>
                        <span class="vc-compare" data-vc-compare {% unless effective_compare > variant.price %}style="display:none;"{% endunless %}>{{ effective_compare | money_without_trailing_zeros }}</span>
                      </span>
                      <span class="vc-per-strip" data-vc-per-strip>({{ per_strip | money }} /Per Strip)</span>
                    </div>
                  </button>
                {%- endfor -%}
              </div>
            </div>

          {%- else -%}

            {%- assign single_variant = product.selected_or_first_available_variant -%}
            {%- assign matched_allocation = blank -%}
            {%- comment -%} Same normalisation as the multi-variant matcher above. {%- endcomment -%}
            {%- for alloc in single_variant.selling_plan_allocations -%}
              {%- assign plan_haystack = alloc.selling_plan.name -%}
              {%- for plan_option in alloc.selling_plan.options -%}
                {%- assign plan_haystack = plan_haystack | append: ' ' | append: plan_option.value -%}
              {%- endfor -%}
              {%- assign plan_name = plan_haystack | downcase | replace: '-', ' ' | replace: '_', ' ' -%}
              {%- if plan_name contains 'month' -%}
                {%- unless plan_name contains '3 month' or plan_name contains '6 month' -%}
                  {%- if matched_allocation == blank -%}
                    {%- assign matched_allocation = alloc -%}
                  {%- endif -%}
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if matched_allocation == blank -%}
              {%- assign matched_allocation = single_variant.selling_plan_allocations.first -%}
            {%- endif -%}

            {%- assign single_effective_compare = single_variant.price -%}
            {%- if single_variant.compare_at_price > single_variant.price -%}
              {%- assign single_effective_compare = single_variant.compare_at_price -%}
            {%- endif -%}

            {%- assign selling_plan_id = '' -%}
            {%- assign sub_price = '' -%}
            {%- assign sub_compare = '' -%}
            {%- assign sub_discount_percent = 0 -%}
            {%- if matched_allocation -%}
              {%- assign selling_plan_id = matched_allocation.selling_plan.id -%}
              {%- comment -%} Always the real checkout price - see the matching comment above for why. {%- endcomment -%}
              {%- assign sub_compare_basis = single_variant.price -%}
              {%- if single_effective_compare > matched_allocation.price -%}
                {%- assign sub_compare_basis = single_effective_compare -%}
              {%- endif -%}
              {%- assign sub_price = matched_allocation.price | money_without_trailing_zeros -%}
              {%- assign sub_compare = sub_compare_basis | money_without_trailing_zeros -%}
              {%- if matched_allocation.price < sub_compare_basis -%}
                {%- assign sub_saved = sub_compare_basis | minus: matched_allocation.price -%}
                {%- assign sub_discount_percent = sub_saved | times: 100 | divided_by: sub_compare_basis -%}
                {%- assign sub_discount_percent = sub_discount_percent | divided_by: 5 | times: 5 -%}
              {%- endif -%}
            {%- endif -%}
            {%- assign first_sub_discount_percent = sub_discount_percent -%}
            {%- assign discount_percent = 0 -%}
            {%- if product.compare_at_price > product.price -%}
              {%- assign saved = product.compare_at_price | minus: product.price -%}
              {%- assign discount_percent = saved | times: 100 | divided_by: product.compare_at_price -%}
              {%- assign discount_percent = discount_percent | divided_by: 5 | times: 5 -%}
            {%- endif -%}
            <input type="hidden" name="id" value="{{ single_variant.id }}" data-single-variant-selling-plan="{{ selling_plan_id }}">
            <div class="product-price-row"
              data-price="{{ product.price | money_without_trailing_zeros }}"
              data-compare="{{ product.compare_at_price | money_without_trailing_zeros }}"
              data-discount="{{ discount_percent }}"
              data-sub-price="{{ sub_price }}"
              data-sub-compare="{{ sub_compare }}"
              data-sub-discount="{{ sub_discount_percent }}">
              <span class="product-price-compare" data-compare-price {% unless product.compare_at_price > product.price %}style="display:none;"{% endunless %}>{{ product.compare_at_price | money_without_trailing_zeros }}</span>
              <span class="product-price-current {% if product.compare_at_price > product.price %}is-discounted{% endif %}" data-current-price>{{ product.price | money_without_trailing_zeros }}</span>
              <span class="product-price-pill" data-price-pill {% if discount_percent == 0 %}style="display:none;"{% endif %}>{{ discount_percent }}% off</span>
            </div>

          {%- endif -%}

          <!-- Purchase options (powered by Loop Subscriptions) -->
          {%- if product.selling_plan_groups.size > 0 -%}
            {% render 'loop-subscriptions', type: 'product-widget', product: product %}
          {%- elsif section.settings.subscribe_note != blank -%}
            <div class="product-subscribe-note">
              <span class="psn-icon">🔄</span>
              <span>{{ section.settings.subscribe_note }}</span>
            </div>
          {%- endif -%}

          {%- comment -%}
            Pre-order notice. Sits directly above the button rather than in the
            trust row below it, so it's read before the click, not after.
          {%- endcomment -%}
          {%- if section.settings.preorder_enabled and product.available -%}
            <div class="product-preorder">
              <span class="preorder-badge">{{ section.settings.preorder_badge }}</span>
              {%- if section.settings.preorder_text != blank -%}
                <span class="preorder-text">{{ section.settings.preorder_text }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          <button type="submit" class="btn-atc" {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}
              {%- if section.settings.preorder_enabled -%}
                {{ section.settings.preorder_badge }} — {{ section.settings.cta_suffix }}
              {%- else -%}
                Add to Cart — {{ section.settings.cta_suffix }}
              {%- endif -%}
            {%- else -%}
              Sold out
            {%- endif -%}
          </button>

          {%- if section.settings.sub_note != blank -%}
            <p class="product-sub-note">{{ section.settings.sub_note }}</p>
          {%- endif -%}

        {%- endform -%}

        <!-- Trust row -->
        <div class="product-trust-row">
          <div class="ptr-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>30-Night Guarantee</span>
          </div>
          <div class="ptr-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span>Free Shipping</span>
          </div>
          <div class="ptr-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Cancel Anytime</span>
          </div>
          <div class="ptr-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            {%- comment -%}
              Has to follow the pre-order switch. Leaving "Ships in 1–2 Days"
              under a pre-order button would promise a dispatch time the order
              can't be filled in.
            {%- endcomment -%}
            <span>{% if section.settings.preorder_enabled %}{{ section.settings.preorder_ships_label }}{% else %}Ships in 1–2 Days{% endif %}</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
(function(){
  const form = document.getElementById('product-form');
  const curEl = form?.querySelector('[data-current-price]');
  const cmpEl = form?.querySelector('[data-compare-price]');
  const pillTopEl = form?.querySelector('[data-price-pill]');

  // Every "Shop now" CTA links to the bare product URL, and this page is
  // meant to land on the 3-month pack (see the matching Liquid default
  // above). Loop's widget picks its own variant from ?variant=, falling back
  // to the first available one, so it would otherwise show the 1-month
  // group's plans next to a 3-month card. Writing the rendered default into
  // the URL keeps both in agreement and makes the landing state shareable.
  // This runs during parse, before Loop's deferred script reads the URL.
  // An explicit ?variant= from the shopper is never overridden.
  (function syncVariantParamToRenderedDefault() {
    const activeCard = form?.querySelector('.variant-card.active');
    if (!activeCard || !activeCard.dataset.variantId) return;
    const url = new URL(window.location.href);
    if (url.searchParams.get('variant')) return;
    url.searchParams.set('variant', activeCard.dataset.variantId);
    history.replaceState(history.state, '', url);
  })();

  // Loop's remotely-configured default purchase option for this store is
  // one-time. Shoppers arrive here from "Shop now" CTAs that promise the
  // subscription pricing, so the flag is forced on before Loop reads it -
  // its config object is assigned by the deferred widget script, hence the
  // accessor rather than a plain assignment.
  //
  // Loop re-reads the same flag on every later variant change, so the
  // override is released as soon as it has been applied once. After that a
  // shopper who deliberately switches to one-time stays on one-time when
  // they change packs, and the pack-switch handler below re-arms the flag
  // only while they are already subscribed.
  (function defaultToSubscribeAndSave() {
    let forced = true;
    let stored = window.loopPropsUI;
    function withSubscriptionDefault(value) {
      if (forced && value && typeof value === 'object') {
        value.byDefaultChooseSubscriptionOption = true;
      }
      return value;
    }
    stored = withSubscriptionDefault(stored);
    Object.defineProperty(window, 'loopPropsUI', {
      configurable: true,
      get() { return stored; },
      set(value) { stored = withSubscriptionDefault(value); }
    });

    (function releaseOnceApplied(attemptsLeft) {
      if (isSubscribed()) {
        forced = false;
        if (stored) stored.byDefaultChooseSubscriptionOption = false;
        // Loop points the subscription at its group's first (cheapest,
        // monthly) plan and re-applies that through an internal
        // setTimeout(..., 300), so the pack's own plan is re-asserted now
        // and again after that has had time to run - same reason as the
        // pack-switch handler below.
        const activeCard = document.querySelector('.variant-card.active');
        syncLoopSellingPlanForCard(activeCard);
        refreshAllPricing();
        setTimeout(() => {
          syncLoopSellingPlanForCard(activeCard);
          refreshAllPricing();
        }, 400);
        return;
      }
      if (attemptsLeft > 0) {
        setTimeout(() => releaseOnceApplied(attemptsLeft - 1), 100);
      } else {
        // Loop never selected a subscription (no plans, or its script failed
        // to load) - stop overriding so nothing is left in a forced state.
        forced = false;
      }
    })(60);
  })();

  // Loop's widget renders its own one-time/subscribe radios asynchronously
  // (after its JS SDK finishes loading), so purchase mode is read live from
  // the DOM rather than cached in a variable.
  function isSubscribed() {
    return !!form?.querySelector('.loop-subscription-group-radio:checked');
  }

  // Update a card's own displayed price/discount pill for the current mode
  function applyCardPricing(card) {
    const subscribed = isSubscribed() && card.dataset.subPrice;
    const price    = subscribed ? card.dataset.subPrice   : card.dataset.price;
    const compare  = subscribed ? card.dataset.subCompare : card.dataset.compare;
    const discount = subscribed ? card.dataset.subDiscount : card.dataset.discount;

    const priceEl = card.querySelector('[data-vc-price]');
    const compareEl = card.querySelector('[data-vc-compare]');
    const pillEl = card.querySelector('[data-vc-pill]');

    if (priceEl) {
      priceEl.textContent = price || '';
    }
    if (compareEl) { compareEl.textContent = compare || ''; compareEl.style.display = compare ? '' : 'none'; }
    if (pillEl) {
      const pct = Number(discount || 0);
      pillEl.textContent = pct + '% off';
      pillEl.style.display = pct > 0 ? '' : 'none';
    }

    const shippingEl = card.querySelector('[data-vc-shipping]');
    if (shippingEl) shippingEl.style.display = isSubscribed() ? '' : 'none';

    const perStripEl = card.querySelector('[data-vc-per-strip]');
    if (perStripEl) {
      const perStrip = subscribed ? card.dataset.subPerStrip : card.dataset.perStrip;
      perStripEl.textContent = perStrip ? '(' + perStrip + ' /Per Strip)' : '';
    }

    return { price, compare };
  }

  // Update the top price row from a given card (or the single-variant row)
  // The "% off" pill is exclusive to Subscribe & Save; the compare-at price still shows for one-time.
  function applyTopPricing(source) {
    if (!source) return;
    const subscribed = isSubscribed() && source.dataset.subPrice;
    const price    = subscribed ? source.dataset.subPrice   : source.dataset.price;
    const compare  = subscribed ? source.dataset.subCompare : source.dataset.compare;
    const discount = subscribed ? source.dataset.subDiscount : 0;
    const hasDiscount = !!compare;

    if (curEl) {
      curEl.textContent = price || '';
      curEl.classList.toggle('is-discounted', hasDiscount);
    }
    if (cmpEl) { cmpEl.textContent = compare || ''; cmpEl.style.display = hasDiscount ? '' : 'none'; }
    if (pillTopEl) {
      const pct = Number(discount || 0);
      pillTopEl.textContent = pct + '% off';
      pillTopEl.style.display = pct > 0 ? '' : 'none';
    }
  }

  // Loop's widget markup has no icons, badge, or perks copy — that content
  // is layered on top here (rather than editing Loop's own snippet files,
  // per their "do not modify" notice) to match the original design.
  function decorateLoopPurchaseOptions() {
    const container = form?.querySelector('.loop-subscription-container');
    if (!container || container.dataset.decorated) return;

    const oneTime = container.querySelector('.loop-one-time-purchase-option');
    const subGroups = container.querySelectorAll('.loop-subscription-group');
    if (!oneTime && !subGroups.length) return;
    container.dataset.decorated = 'true';

    const bagIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`;
    const refreshIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>`;

    function addExpandingPerks(parent, html) {
      const expand = document.createElement('div');
      expand.className = 'loop-custom-expand';
      const perks = document.createElement('div');
      perks.className = 'loop-custom-perks';
      perks.innerHTML = html;
      expand.appendChild(perks);
      parent.appendChild(expand);
    }

    if (oneTime) {
      const label = oneTime.querySelector('.loop-one-time-purchase-option-label');
      if (label) {
        const icon = document.createElement('span');
        icon.className = 'loop-custom-icon';
        icon.innerHTML = bagIcon;
        label.before(icon);

        const summary = document.createElement('span');
        summary.className = 'loop-custom-summary';
        summary.textContent = 'No automatic deliveries';
        label.after(summary);
      }
      addExpandingPerks(oneTime, `
        <span>\u{2713} 30-Day Risk Free Trial.</span>
        <span>\u{2713} Flat Fee Shipping</span>
      `);
    }

    subGroups.forEach(group => {
      const label = group.querySelector('.loop-subscription-group-label');
      const textWrap = group.querySelector('.loop-subscription-group-text');
      if (label) {
        const icon = document.createElement('span');
        icon.className = 'loop-custom-icon';
        icon.innerHTML = refreshIcon;
        label.before(icon);
      }
      if (textWrap) {
        const badge = document.createElement('span');
        badge.className = 'loop-custom-badge';
        badge.textContent = 'Recommended';
        textWrap.appendChild(badge);

        const summary = document.createElement('span');
        summary.className = 'loop-custom-summary';
        summary.innerHTML = 'Auto-Delivered \u{B7} Cancel Anytime';
        textWrap.appendChild(summary);
      }
      addExpandingPerks(group, `
        <span>\u{1FA99} Instant <span class="loop-custom-discount">{{ first_sub_discount_percent }}</span>% Off</span>
        <span>\u{1F4E6} Delivered every 30, 90 or 180 Days</span>
        <span>\u{1F6E1}\u{FE0F} 30-Day Risk Free Trial</span>
        <span>\u{2708}\u{FE0F} Free Shipping Australia Wide</span>
        <span>\u{1F310} 30% off shipping to US, CA, NZ, &amp; SG</span>
        <span>\u{1F4F1} Cancel or Pause Anytime</span>
      `);
    });
  }

  function updateLoopPerksDiscount(source) {
    if (!source) return;
    // Every variant's subscription group gets its own perks block (only the
    // active one is visible at a time), so update them all rather than just
    // the first one in DOM order - otherwise switching packs could keep
    // showing whichever variant happened to render first.
    form?.querySelectorAll('.loop-custom-discount').forEach(discountEl => {
      discountEl.textContent = source.dataset.subDiscount || '0';
    });
  }

  function refreshAllPricing() {
    document.querySelectorAll('.variant-card').forEach(applyCardPricing);
    const activeCard = document.querySelector('.variant-card.active');
    if (activeCard) {
      applyTopPricing(activeCard);
      updateLoopPerksDiscount(activeCard);
    } else {
      const priceRow = form?.querySelector('.product-price-row[data-sub-price]');
      if (priceRow) {
        applyTopPricing(priceRow);
        updateLoopPerksDiscount(priceRow);
      }
    }
  }

  decorateLoopPurchaseOptions();

  // Loop's own "delivery frequency" dropdown is hidden (see
  // loop-widget-theme.css) since the pack cards above already pick a
  // frequency. This keeps Loop's plan selection silently pointed at the
  // same selling plan the pack card already resolved server-side, so
  // checkout still gets the right plan without showing a second control.
  function syncLoopSellingPlanForCard(card) {
    if (!card) return;
    const variantId = card.dataset.variantId;
    const planId = card.dataset.sellingPlanId;
    if (!variantId || !planId) return;
    const select = document.querySelector(
      '#loop-product-variant-' + variantId + ' .loop-selling-plan-selector'
    );
    if (select && select.value !== planId) {
      select.value = planId;
      select.dispatchEvent(new Event('change', { bubbles: true }));
    }
    // Loop's own group-selection handling can silently reset the actual
    // submitted plan back to the group's first (cheapest) allocation,
    // independent of what the select above already shows correctly - so
    // the real hidden field checkout reads from is always force-set here
    // too, not just left to Loop's change-event handling.
    const hiddenInput = form?.querySelector('input[name="selling_plan"]');
    if (hiddenInput) hiddenInput.value = planId;
  }

  // Loop's widget loads asynchronously, so poll briefly until its plan
  // selector for the active pack actually exists before syncing it.
  (function waitForLoopWidgetReady(attemptsLeft) {
    const card = document.querySelector('.variant-card.active')
      || document.querySelector('[data-variant-picker] .variant-card');
    if (!card) return;
    const select = document.querySelector(
      '#loop-product-variant-' + card.dataset.variantId + ' .loop-selling-plan-selector'
    );
    if (select) {
      syncLoopSellingPlanForCard(card);
    } else if (attemptsLeft > 0) {
      setTimeout(() => waitForLoopWidgetReady(attemptsLeft - 1), 150);
    }
  })(40);

  // Loop's radios/selects are injected into the DOM after its widget loads,
  // so listen via delegation on the form rather than binding to elements
  // that don't exist yet.
  form?.addEventListener('change', (event) => {
    if (event.target.closest('.loop-selling-plan-fieldset')) {
      refreshAllPricing();
    }
  });

  document.querySelectorAll('[data-variant-picker]').forEach(picker => {
    const frm   = picker.closest('form');
    const cards = picker.querySelectorAll('.variant-card');
    const input = frm?.querySelector('[data-variant-input]');

    cards.forEach(applyCardPricing);

    cards.forEach(card => {
      card.addEventListener('click', () => {
        const wasSubscribed = isSubscribed();

        // Loop's own variant-change handling always re-selects its
        // configured default purchase option (one-time, in this store),
        // which was dropping the shopper's Subscribe & Save choice and
        // visibly flashing through the one-time state on the way back.
        // Flipping this flag makes Loop choose Subscribe & Save as *its*
        // default for this transition, so it never touches one-time at all
        // - nothing to flash, nothing to correct after the fact.
        let restoreDefaultFlag = false;
        if (wasSubscribed && window.loopPropsUI && !window.loopPropsUI.byDefaultChooseSubscriptionOption) {
          window.loopPropsUI.byDefaultChooseSubscriptionOption = true;
          restoreDefaultFlag = true;
        }

        cards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        if (input) {
          input.value = card.dataset.variantId;
          // Loop's widget watches this input via a MutationObserver on
          // attribute changes to know when the shopper picks a different
          // pack, so the attribute (not just the DOM property) must change.
          input.setAttribute('value', card.dataset.variantId);
        }
        syncLoopSellingPlanForCard(card);
        refreshAllPricing();

        if (restoreDefaultFlag) {
          // Restore the flag after Loop's reset has used it, so future
          // page loads and pack switches that start from one-time still
          // default to one-time as configured.
          queueMicrotask(() => {
            window.loopPropsUI.byDefaultChooseSubscriptionOption = false;
            syncLoopSellingPlanForCard(card);
            refreshAllPricing();
          });
        }

        // Loop's own group-selection handler resets its (hidden) frequency
        // dropdown back to its first option via an internal setTimeout(...,
        // 300), which runs after the sync above and would otherwise silently
        // send every pack back to the cheapest ("every month") plan at
        // checkout. Re-apply the correct plan once that has had time to run.
        setTimeout(() => {
          syncLoopSellingPlanForCard(card);
          refreshAllPricing();
        }, 400);
      });
    });
  });

  refreshAllPricing();

  // Gallery: thumbnail clicks + prev/next arrows slide the track (all full-size images are already in the DOM, so switching never re-loads or blurs)
  const galleryTrack = document.querySelector('[data-gallery-track]');
  const galleryThumbs = Array.from(document.querySelectorAll('[data-gallery-thumb]'));
  const galleryPrevBtn = document.querySelector('[data-gallery-prev]');
  const galleryNextBtn = document.querySelector('[data-gallery-next]');

  function updateGalleryArrows(index) {
    if (galleryPrevBtn) galleryPrevBtn.disabled = index <= 0;
    if (galleryNextBtn) galleryNextBtn.disabled = index >= galleryThumbs.length - 1;
  }

  function showGalleryIndex(index) {
    if (!galleryTrack || !galleryThumbs.length) return;
    const thumb = galleryThumbs[index];
    if (!thumb) return;
    galleryTrack.style.transform = `translateX(-${index * 100}%)`;
    galleryThumbs.forEach(t => t.classList.remove('active'));
    thumb.classList.add('active');
    updateGalleryArrows(index);
  }

  galleryThumbs.forEach((thumb, index) => {
    thumb.addEventListener('click', () => showGalleryIndex(index));
  });

  function currentGalleryIndex() {
    const active = galleryThumbs.findIndex(t => t.classList.contains('active'));
    return active === -1 ? 0 : active;
  }

  galleryPrevBtn?.addEventListener('click', () => {
    const next = currentGalleryIndex() - 1;
    if (next >= 0) showGalleryIndex(next);
  });
  galleryNextBtn?.addEventListener('click', () => {
    const next = currentGalleryIndex() + 1;
    if (next < galleryThumbs.length) showGalleryIndex(next);
  });

  updateGalleryArrows(currentGalleryIndex());

  document.querySelectorAll('[data-gallery-faq] .gallery-faq-summary').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.gallery-faq-item');
      const body = item.querySelector('.gallery-faq-body');
      if (item.classList.contains('is-open')) {
        item.classList.remove('is-open');
        body.style.maxHeight = '0px';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        item.classList.add('is-open');
        body.style.maxHeight = body.scrollHeight + 'px';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
})();
</script>

