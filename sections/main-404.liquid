{%- comment -%}
  404 page. Previously this template loaded main-page, which prints page.title
  and page.content - both empty on a 404, so a bad URL rendered a blank page.
{%- endcomment -%}
<section class="notfound" style="{% render 'section-color-vars', section: section %}">
  <div class="container">
    <div class="notfound-inner">
      <span class="notfound-code" aria-hidden="true">404</span>
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.body != blank -%}
        <p class="notfound-body">{{ section.settings.body }}</p>
      {%- endif -%}

      <form action="{{ routes.search_url }}" method="get" role="search" class="notfound-search">
        <label class="visually-hidden" for="notfound-search-input">{{ 'general.search.placeholder' | t }}</label>
        <input
          type="search"
          id="notfound-search-input"
          name="q"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
        >
        <button type="submit">{{ 'general.search.submit' | t }}</button>
      </form>

      <div class="notfound-actions">
        <a href="{{ routes.root_url }}" class="btn-primary btn-dark">{{ section.settings.button_text }}</a>
        {%- if section.settings.link_text != blank -%}
          <a href="{{ section.settings.link_url | default: routes.root_url }}" class="notfound-link">{{ section.settings.link_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0e1a3a" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text color", "default": "#5a6580" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#0e1a3a" },
    { "type": "color", "id": "card_background_color", "label": "Card background color", "default": "#ffffff" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has drifted off." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "The link you followed doesn't lead anywhere any more. Search for what you were after, or head back and start again." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Back to home" },
    { "type": "text", "id": "link_text", "label": "Secondary link text", "default": "Shop Dreamtape" },
    { "type": "url", "id": "link_url", "label": "Secondary link" }
  ]
}
{% endschema %}
