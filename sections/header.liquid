{%- comment -%}
  Shipping protection rides along on every order as its own cart line, but it
  is surfaced in the cart footer rather than as a removable item — so it is
  filtered out of the item list and the cart count everywhere below.
{%- endcomment -%}
{%- assign protection_variant_id = all_products['shipping-protection'].variants.first.id -%}
{%- assign shoppable_items = cart.items -%}
{%- if protection_variant_id != blank -%}
  {%- assign shoppable_items = cart.items | reject: 'variant_id', protection_variant_id -%}
{%- endif -%}
{%- assign shoppable_count = 0 -%}
{%- for item in shoppable_items -%}
  {%- assign shoppable_count = shoppable_count | plus: item.quantity -%}
{%- endfor -%}
<header class="header" style="{% render 'section-color-vars', section: section %}">
  <div class="header-inner">
    <button class="hamburger" aria-label="Open menu" data-menu-open>
      <span></span><span></span><span></span>
    </button>
    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name }} home">
      <img
        src="{{ 'dreamtape-logo.png' | asset_url }}"
        alt="{{ shop.name }}"
        class="logo-image"
        width="1006"
        height="233"
      >
    </a>
    {%- assign nav_blocks = section.blocks | where: 'type', 'nav_link' -%}
    {%- assign use_custom_nav = false -%}
    {%- if nav_blocks.size > 0 -%}
      {%- assign use_custom_nav = true -%}
    {%- endif -%}
    {%- assign has_faq_link = false -%}
    {%- unless use_custom_nav -%}
      {%- for link in section.settings.menu.links -%}
        {%- assign link_title = link.title | downcase -%}
        {%- if link_title == 'faq' or link.url contains '/pages/faq' or link.url contains 'view=faq' -%}
          {%- assign has_faq_link = true -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endunless -%}
    <nav class="nav-desktop">
      {%- if use_custom_nav -%}
        {%- for block in nav_blocks -%}
          {%- if block.settings.label != blank -%}
            <a href="{{ block.settings.link | default: routes.root_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
        {%- unless has_faq_link -%}
          <a href="/search?view=faq">FAQ</a>
        {%- endunless -%}
      {%- endif -%}
    </nav>
    <div class="header-actions">
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_link }}" class="btn-shop">{{ section.settings.cta_text }}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="cart-btn" aria-label="Cart" data-cart-open>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        <span class="cart-count">{{ shoppable_count }}</span>
      </a>
    </div>
  </div>
</header>

<div class="mobile-menu-backdrop" id="mobileMenuBackdrop" data-menu-close></div>
<div class="mobile-menu" id="mobileMenu">
  <button class="close-btn" data-menu-close>&times;</button>
  {%- if use_custom_nav -%}
    {%- for block in nav_blocks -%}
      {%- if block.settings.label != blank -%}
        <a href="{{ block.settings.link | default: routes.root_url }}" data-menu-close {{ block.shopify_attributes }}>
          <span>{{ block.settings.label }}</span>
          <span aria-hidden="true">{% render 'nav-emoji', label: block.settings.label %}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}" data-menu-close>
        <span>{{ link.title }}</span>
        <span aria-hidden="true">{% render 'nav-emoji', label: link.title %}</span>
      </a>
    {%- endfor -%}
    {%- unless has_faq_link -%}
      <a href="/search?view=faq" data-menu-close>
        <span>FAQ</span>
        <span aria-hidden="true">❓</span>
      </a>
    {%- endunless -%}
  {%- endif -%}
</div>

<div class="cart-drawer-backdrop" id="cartDrawerBackdrop" data-cart-close></div>
<div class="cart-drawer" id="cartDrawer" role="dialog" aria-modal="true" aria-label="Your cart">
  <div class="cart-drawer-header">
    <h2>Your cart</h2>
    <button class="close-btn" data-cart-close aria-label="Close cart">&times;</button>
  </div>
  <div class="cart-drawer-items" id="cartDrawerItems">
    {%- if shoppable_items.size > 0 -%}
      {%- for item in shoppable_items -%}
        <div class="cart-drawer-item" data-line-key="{{ item.key }}">
          <a href="{{ item.url }}">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}">
            {%- else -%}
              <div class="cart-drawer-item-placeholder">◐</div>
            {%- endif -%}
          </a>
          <div class="cart-drawer-item-info">
            <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
            {%- if item.variant.title != 'Default Title' -%}
              <p class="cart-drawer-item-variant">{{ item.variant.title }}</p>
            {%- endif -%}
            <div class="cart-drawer-item-qty">
              <button type="button" data-cart-qty-decrease aria-label="Decrease quantity">&minus;</button>
              <span data-cart-qty-value>{{ item.quantity }}</span>
              <button type="button" data-cart-qty-increase aria-label="Increase quantity">+</button>
            </div>
          </div>
          <div class="cart-drawer-item-side">
            <p class="cart-drawer-item-price">{{ item.final_line_price | money_without_trailing_zeros }}</p>
            <button type="button" class="cart-drawer-item-remove" data-cart-remove aria-label="Remove {{ item.product.title | escape }}">Remove</button>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="cart-drawer-empty">
        <p>Your cart is empty.</p>
        <a href="/products/mouth-tape" class="btn-primary btn-dark" data-cart-close>Shop Dreamtape <span class="arrow">→</span></a>
      </div>
    {%- endif -%}
  </div>
  <div class="cart-drawer-footer" id="cartDrawerFooter" {% if shoppable_items.size == 0 %}hidden{% endif %}>
    {% render 'shipping-protection-row' %}
    <a href="/checkout" class="btn-primary btn-dark btn-large cart-drawer-checkout">
      <span>Checkout</span>
      <span class="cart-drawer-checkout-dot" aria-hidden="true">&bull;</span>
      <span class="cart-drawer-total-value">{{ cart.total_price | money_without_trailing_zeros }}</span>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0e1a3a"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text color",
      "default": "#5a6580"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0e1a3a"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Fallback main menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Mouth Tape"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
