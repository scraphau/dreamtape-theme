{%- comment -%}
  Structured data for search engines and for the models that answer questions
  from search results. Both read JSON-LD in preference to guessing from markup.

  Deliberately absent: aggregateRating. The star rating on the product page is
  a piece of theme copy, not review data - there is no review app on this store
  and nothing counts those 462 reviews. Marking it up as a real rating is what
  Google's structured data policy calls out, and it risks a manual action
  against the whole site rather than just losing the stars.

  Add it the day a review app is installed and the number is real.
{%- endcomment -%}

{%- assign shop_logo = 'dreamtape-logo.png' | asset_url | prepend: 'https:' | split: '?' | first -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "logo": {{ shop_logo | json }}
  {%- if shop.description != blank -%},
  "description": {{ shop.description | json }}
  {%- endif -%}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- if request.page_type == 'product' and product != blank -%}
  {%- liquid
    assign product_description = product.description | strip_html | strip | truncate: 400
    if product_description == blank
      assign product_description = page_description | default: product.title
    endif

    assign lowest = product.price_min | divided_by: 100.0
    assign highest = product.price_max | divided_by: 100.0

    if product.available
      assign availability = 'https://schema.org/InStock'
    else
      assign availability = 'https://schema.org/OutOfStock'
    endif
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product_description | json }},
    "url": {{ shop.url | append: product.url | json }},
    {%- if product.featured_image -%}
    "image": [
      {%- for image in product.images limit: 5 -%}
        {{ image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    {%- endif -%}
    {%- if product.vendor != blank -%}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    {%- endif -%}
    {%- if product.type != blank -%}
    "category": {{ product.type | json }},
    {%- endif -%}
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "lowPrice": {{ lowest | json }},
      "highPrice": {{ highest | json }},
      "offerCount": {{ product.variants.size }},
      "availability": {{ availability | json }},
      "url": {{ shop.url | append: product.url | json }},
      "offers": [
        {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "name": {{ variant.title | json }},
          "sku": {{ variant.sku | default: variant.id | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
          "url": {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
    ]
  }
  </script>
{%- endif -%}
