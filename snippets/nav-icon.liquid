{%- comment -%}
  Hand-drawn nav marks for the mobile menu, matched to a link by its label.
  These replace the emoji that used to sit here: emoji render in each device's
  own font, so the set never looked like one family and never picked up the
  theme's blue. Drawn on a 24x24 box with round caps and a lighter accent
  stroke so they read as ink sketches at the 26px the menu shows them at.

  Decorative only - the link's own text carries the meaning, so the caller
  marks the wrapper aria-hidden.
{%- endcomment -%}
{%- liquid
  assign label_lower = label | downcase
  assign icon = ''
  if label_lower contains 'home'
    assign icon = 'home'
  elsif label_lower contains 'nose'
    assign icon = 'nose'
  elsif label_lower contains 'mouth' or label_lower contains 'tape'
    assign icon = 'mouth'
  elsif label_lower contains 'contact'
    assign icon = 'contact'
  elsif label_lower contains 'faq'
    assign icon = 'faq'
  endif
-%}
{%- if icon != '' -%}
  <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case icon -%}
      {%- when 'home' -%}
        <path d="M3.4 11.4 12 4.2l8.6 7.2"/>
        <path d="M5.9 10.3v9.1c0 .3.3.6.6.6h11c.3 0 .6-.3.6-.6v-9.1"/>
        <path d="M9.9 20v-4.4c0-.3.2-.5.5-.5h3.2c.3 0 .5.2.5.5V20"/>
        <path d="M6.8 12.6v5.6" opacity=".45"/>
      {%- when 'nose' -%}
        <path d="M4.2 8.4c2.7.2 4.4 1 7.8 1s5.1-.8 7.8-1c.4 0 .7.3.7.7v5.8c0 .4-.3.7-.7.7-2.7-.2-4.4-1-7.8-1s-5.1.8-7.8 1c-.4 0-.7-.3-.7-.7V9.1c0-.4.3-.7.7-.7z"/>
        <path d="M9.6 11.2v1.6" opacity=".45"/>
        <path d="M12 11.2v1.6" opacity=".45"/>
        <path d="M14.4 11.2v1.6" opacity=".45"/>
      {%- when 'mouth' -%}
        <circle cx="11" cy="13" r="7.2"/>
        <path d="M7.2 11.4c.7-.8 1.9-.8 2.6 0"/>
        <path d="M12.2 11.4c.7-.8 2-.8 2.7 0"/>
        <rect x="3.4" y="14.5" width="15.2" height="3.4" rx="1" transform="rotate(-6 11 16.2)"/>
        <path d="M7.1 15.3 6.3 17.6" opacity=".45"/>
        <path d="M15.7 14.4 14.9 16.7" opacity=".45"/>
        <path d="M18.4 4.2H21l-2.6 3H21"/>
      {%- when 'contact' -%}
        <rect x="3.3" y="5.9" width="17.4" height="12.2" rx="2.2"/>
        <path d="M4.3 7.6 12 13.1l7.7-5.5"/>
        <path d="M4.6 16.6 9.4 12.4" opacity=".45"/>
        <path d="M19.4 16.6 14.6 12.4" opacity=".45"/>
      {%- when 'faq' -%}
        <path d="M4.1 6.6a2.5 2.5 0 0 1 2.5-2.5h10.8a2.5 2.5 0 0 1 2.5 2.5v6.9a2.5 2.5 0 0 1-2.5 2.5h-6.6l-4.4 3.4v-3.4h-.3a2.5 2.5 0 0 1-2.5-2.5z"/>
        <path d="M9.7 8.4c.2-1.2 1.2-2.1 2.4-2.1 1.3 0 2.4 1 2.4 2.2 0 1.5-2 1.8-2.2 3.2"/>
        <path d="M12.2 13.7h.01"/>
    {%- endcase -%}
  </svg>
{%- endif -%}
