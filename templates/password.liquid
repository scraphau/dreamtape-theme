{%- comment -%}
  Shown while the storefront is password protected. Without this template
  Shopify falls back to its own unstyled page, which is the first thing anyone
  with the link sees pre-launch.

  The signup form is Shopify's built-in one, so addresses collected here land
  in Customers as marketing contacts with no app required.
{%- endcomment -%}
<div class="password-page">
  <div class="password-inner">

    {%- if shop.brand.logo != blank -%}
      <img class="password-logo" src="{{ shop.brand.logo | image_url: width: 600 }}" alt="{{ shop.name }}" width="300" height="70">
    {%- else -%}
      <img class="password-logo" src="{{ 'dreamtape-logo.png' | asset_url }}" alt="{{ shop.name }}" width="1006" height="233">
    {%- endif -%}

    <h1>Something worth losing sleep over. Briefly.</h1>
    <p class="password-body">
      We're putting the finishing touches on the store. Leave your email and we'll
      tell you the moment it opens.
    </p>

    {%- form 'customer', class: 'password-signup' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success">Thanks — we'll be in touch.</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="prelaunch">
        <label class="visually-hidden" for="password-email">Email</label>
        <div class="password-signup-row">
          <input
            type="email"
            id="password-email"
            name="contact[email]"
            placeholder="your@email.com"
            autocomplete="email"
            required
          >
          <button type="submit" class="btn-primary btn-dark">Notify me</button>
        </div>
        {%- if form.errors -%}
          <p class="form-error">{{ form.errors.messages['email'] | default: 'That email address does not look right.' }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

    <div class="password-enter">
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <p class="form-error">Wrong password — try again.</p>
        {%- endif -%}
        <label for="storefront-password">Have the password?</label>
        <div class="password-signup-row">
          <input type="password" id="storefront-password" name="password" autocomplete="current-password">
          <button type="submit" class="btn-outline">Enter</button>
        </div>
      {%- endform -%}
    </div>

    <p class="password-footer">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</div>
