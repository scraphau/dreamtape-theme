{%- comment -%}
  Gift card recipients land here from the emailed link. Without this template
  the page fails, so any gift card sold would be unredeemable from the link.
{%- endcomment -%}
<section class="account-page">
  <div class="container container--narrow">
    <div class="account-card giftcard-card">
      <h1>Your gift card</h1>
      <p class="giftcard-amount">{{ gift_card.balance | money }}</p>
      {%- if gift_card.balance != gift_card.initial_value -%}
        <p class="account-empty">Originally {{ gift_card.initial_value | money }}</p>
      {%- endif -%}

      {%- if gift_card.expired -%}
        <p class="form-error">This gift card expired on {{ gift_card.expires_on | date: '%d %B %Y' }}.</p>
      {%- elsif gift_card.expires_on -%}
        <p class="account-empty">Valid until {{ gift_card.expires_on | date: '%d %B %Y' }}</p>
      {%- endif -%}

      <p class="giftcard-code">{{ gift_card.code | format_code }}</p>
      <p class="account-intro">Enter this code at checkout.</p>

      <a href="{{ shop.url }}" class="btn-primary btn-dark btn-full">Start shopping</a>
    </div>
  </div>
</section>
