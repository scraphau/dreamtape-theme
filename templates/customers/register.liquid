<section class="account-page">
  <div class="container container--narrow">
    <div class="account-card">
      <h1>Create an account</h1>
      <p class="account-intro">An account lets you track orders and manage any subscription — skip a delivery, change the date, or cancel.</p>

      {%- form 'create_customer' -%}
        {{ form.errors | default_errors }}

        <label for="register-first">First name</label>
        <input type="text" id="register-first" name="customer[first_name]" autocomplete="given-name">

        <label for="register-last">Last name</label>
        <input type="text" id="register-last" name="customer[last_name]" autocomplete="family-name">

        <label for="register-email">Email</label>
        <input type="email" id="register-email" name="customer[email]" autocomplete="email" required>

        <label for="register-password">Password</label>
        <input type="password" id="register-password" name="customer[password]" autocomplete="new-password" required>

        <button type="submit" class="btn-primary btn-dark btn-full">Create account</button>
      {%- endform -%}

      <div class="account-alt">
        <span>Already have one? <a href="{{ routes.account_login_url }}">Sign in</a></span>
      </div>
    </div>
  </div>
</section>
