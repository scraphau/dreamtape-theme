{%- comment -%}
  Classic customer accounts. Needed for subscriptions above all else: Loop's
  portal link is built from customer.id, so without an account area there is no
  route for a subscriber to skip, reschedule, pause or cancel.
{%- endcomment -%}
<section class="account-page">
  <div class="container container--narrow">
    <div class="account-card">
      <h1>{{ 'customer.login_page.title' | t }}</h1>

      {%- comment -%} Shown after a reset request; Shopify sets this on redirect. {%- endcomment -%}
      <div id="recover-password" class="account-recover" hidden>
        {%- form 'recover_customer_password' -%}
          <h2>Reset your password</h2>
          {%- if form.posted_successfully? -%}
            <p class="form-success">We've sent you an email with a reset link.</p>
          {%- endif -%}
          {{ form.errors | default_errors }}
          <label for="recover-email">Email</label>
          <input type="email" id="recover-email" name="email" autocomplete="email" required>
          <button type="submit" class="btn-primary btn-dark btn-full">Send reset link</button>
          <button type="button" class="account-link" data-recover-cancel>Back to login</button>
        {%- endform -%}
      </div>

      <div id="login-form">
        {%- form 'customer_login' -%}
          {{ form.errors | default_errors }}

          <label for="login-email">Email</label>
          <input type="email" id="login-email" name="customer[email]" autocomplete="email" required>

          <label for="login-password">Password</label>
          <input type="password" id="login-password" name="customer[password]" autocomplete="current-password" required>

          <button type="submit" class="btn-primary btn-dark btn-full">Sign in</button>
        {%- endform -%}

        <div class="account-alt">
          <button type="button" class="account-link" data-recover-open>Forgot your password?</button>
          <span>
            New here? <a href="{{ routes.account_register_url }}">Create an account</a>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var recover = document.getElementById('recover-password');
    var login = document.getElementById('login-form');
    if (!recover || !login) return;

    function show(showRecover) {
      recover.hidden = !showRecover;
      login.hidden = showRecover;
    }

    document.querySelector('[data-recover-open]')?.addEventListener('click', function () { show(true); });
    document.querySelector('[data-recover-cancel]')?.addEventListener('click', function () { show(false); });

    // Shopify redirects back here with #recover after a reset request, and
    // re-renders the form with errors on failure - both need it open on load.
    if (window.location.hash === '#recover' || recover.querySelector('.form-success, .errors')) show(true);
  })();
</script>
