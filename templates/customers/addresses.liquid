<section class="account-page">
  <div class="container container--narrow">
    <div class="page-header">
      <h1>Your addresses</h1>
    </div>

    <div class="account-card">
      <h2>Add a new address</h2>
      {%- form 'customer_address', customer.new_address -%}
        {{ form.errors | default_errors }}

        <label for="address-first">First name</label>
        <input type="text" id="address-first" name="address[first_name]" autocomplete="given-name">

        <label for="address-last">Last name</label>
        <input type="text" id="address-last" name="address[last_name]" autocomplete="family-name">

        <label for="address-1">Address</label>
        <input type="text" id="address-1" name="address[address1]" autocomplete="address-line1">

        <label for="address-2">Apartment, suite, etc.</label>
        <input type="text" id="address-2" name="address[address2]" autocomplete="address-line2">

        <label for="address-city">City</label>
        <input type="text" id="address-city" name="address[city]" autocomplete="address-level2">

        <label for="address-province">State / province</label>
        <input type="text" id="address-province" name="address[province]" autocomplete="address-level1">

        <label for="address-zip">Postcode</label>
        <input type="text" id="address-zip" name="address[zip]" autocomplete="postal-code">

        <label for="address-country">Country</label>
        <input type="text" id="address-country" name="address[country]" autocomplete="country-name">

        <label for="address-phone">Phone</label>
        <input type="tel" id="address-phone" name="address[phone]" autocomplete="tel">

        <button type="submit" class="btn-primary btn-dark btn-full">Save address</button>
      {%- endform -%}
    </div>

    {%- if customer.addresses.size > 0 -%}
      <div class="address-list">
        {%- for address in customer.addresses -%}
          <div class="address-item">
            {%- if address == customer.default_address -%}
              <span class="address-default">Default</span>
            {%- endif -%}
            <address>{{ address | format_address }}</address>
            {%- form 'customer_address', address -%}
              <button type="submit" name="_method" value="delete" class="account-link">Delete</button>
            {%- endform -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="account-empty">No addresses saved yet.</p>
    {%- endif -%}

    <a href="{{ routes.account_url }}" class="account-link">&larr; Back to account</a>
  </div>
</section>
