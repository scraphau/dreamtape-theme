{% doc %}
  @prompt
    add a newsletter popup
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture form_class %}ai-newsletter-popup-{{ ai_gen_id }}__form{% endcapture %}
{% style %}
.ai-newsletter-popup-{{ ai_gen_id }}{display:block;width:100%}.ai-newsletter-popup-{{ ai_gen_id }}__trigger{display:inline-flex;align-items:center;justify-content:center;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;padding:14px 24px;border:1px solid {{ block.settings.button_color }};border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font:inherit;font-weight:700;cursor:pointer}.ai-newsletter-popup-{{ ai_gen_id }}__trigger:hover,.ai-newsletter-popup-{{ ai_gen_id }}__submit:hover{background:{{ block.settings.button_hover_color }}}.ai-newsletter-popup-{{ ai_gen_id }}__overlay{position:fixed;inset:0;z-index:999;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(7,16,42,.68)}.ai-newsletter-popup-{{ ai_gen_id }}__overlay.is-open{display:flex}.ai-newsletter-popup-{{ ai_gen_id }}__dialog{position:relative;width:min(100%,500px);padding:42px 36px 36px;border-radius:{{ block.settings.popup_radius }}px;background:{{ block.settings.popup_background }};color:{{ block.settings.popup_text_color }};box-shadow:0 18px 60px rgba(7,16,42,.24)}.ai-newsletter-popup-{{ ai_gen_id }}__close{position:absolute;top:12px;right:14px;width:36px;height:36px;border:0;background:transparent;color:inherit;font-size:28px;line-height:1;cursor:pointer}.ai-newsletter-popup-{{ ai_gen_id }}__heading{margin:0 28px 10px 0;font-size:{{ block.settings.heading_size }}px;line-height:1.15}.ai-newsletter-popup-{{ ai_gen_id }}__text{margin:0 0 24px;color:{{ block.settings.popup_muted_color }};line-height:1.5}.ai-newsletter-popup-{{ ai_gen_id }}__form{display:grid;gap:12px}.ai-newsletter-popup-{{ ai_gen_id }}__input{width:100%;box-sizing:border-box;padding:14px 15px;border:1px solid {{ block.settings.input_border_color }};border-radius:{{ block.settings.input_radius }}px;background:{{ block.settings.input_background }};color:{{ block.settings.popup_text_color }};font:inherit}.ai-newsletter-popup-{{ ai_gen_id }}__submit{padding:14px 20px;border:0;border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font:inherit;font-weight:700;cursor:pointer}.ai-newsletter-popup-{{ ai_gen_id }}__message{margin:4px 0 0;color:{{ block.settings.popup_text_color }}}.ai-newsletter-popup-{{ ai_gen_id }}__label{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media screen and (max-width:749px){.ai-newsletter-popup-{{ ai_gen_id }}__dialog{padding:38px 22px 24px}}
{% endstyle %}
<newsletter-popup-{{ ai_gen_id }} class="ai-newsletter-popup-{{ ai_gen_id }}" {{ block.shopify_attributes }}><button type="button" class="ai-newsletter-popup-{{ ai_gen_id }}__trigger" aria-haspopup="dialog" aria-controls="ai-newsletter-dialog-{{ ai_gen_id }}">{{ block.settings.trigger_label | escape }}</button><div class="ai-newsletter-popup-{{ ai_gen_id }}__overlay" data-overlay><div id="ai-newsletter-dialog-{{ ai_gen_id }}" class="ai-newsletter-popup-{{ ai_gen_id }}__dialog" role="dialog" aria-modal="true" aria-labelledby="ai-newsletter-heading-{{ ai_gen_id }}" tabindex="-1"><button type="button" class="ai-newsletter-popup-{{ ai_gen_id }}__close" data-close aria-label="Close">&times;</button><h2 id="ai-newsletter-heading-{{ ai_gen_id }}" class="ai-newsletter-popup-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2><p class="ai-newsletter-popup-{{ ai_gen_id }}__text">{{ block.settings.description | escape }}</p>{% form 'customer', class: form_class %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="ai-newsletter-email-{{ ai_gen_id }}" class="ai-newsletter-popup-{{ ai_gen_id }}__label">Email address</label><input id="ai-newsletter-email-{{ ai_gen_id }}" class="ai-newsletter-popup-{{ ai_gen_id }}__input" type="email" name="contact[email]" autocomplete="email" placeholder="{{ block.settings.email_placeholder | escape }}" required><button type="submit" class="ai-newsletter-popup-{{ ai_gen_id }}__submit">{{ block.settings.submit_label | escape }}</button>{% if form.posted_successfully? %}<p class="ai-newsletter-popup-{{ ai_gen_id }}__message">{{ block.settings.success_message | escape }}</p>{% endif %}{% if form.errors %}<p class="ai-newsletter-popup-{{ ai_gen_id }}__message">Please enter a valid email address.</p>{% endif %}{% endform %}</div></div></newsletter-popup-{{ ai_gen_id }}>
<script>(function(){class NewsletterPopup{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.overlay=this.querySelector('[data-overlay]');this.dialog=this.querySelector('[role="dialog"]');this.trigger=this.querySelector('.ai-newsletter-popup-{{ ai_gen_id }}__trigger');this.closeButton=this.querySelector('[data-close]');this.trigger.addEventListener('click',()=>this.open());this.closeButton.addEventListener('click',()=>this.close());this.overlay.addEventListener('click',e=>{if(e.target===this.overlay)this.close()});this.addEventListener('keydown',e=>{if(e.key==='Escape')this.close()})}open(){this.overlay.classList.add('is-open');this.dialog.focus()}close(){this.overlay.classList.remove('is-open');this.trigger.focus()}}customElements.define('newsletter-popup-{{ ai_gen_id }}',NewsletterPopup{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Newsletter popup","settings":[{"type":"header","content":"Content"},{"type":"text","id":"trigger_label","label":"Trigger label","default":"Join our newsletter"},{"type":"text","id":"heading","label":"Heading","default":"Stay in the loop"},{"type":"textarea","id":"description","label":"Description","default":"Get wellness tips, product news and exclusive offers delivered to your inbox."},{"type":"text","id":"email_placeholder","label":"Email placeholder","default":"Enter your email address"},{"type":"text","id":"submit_label","label":"Submit label","default":"Sign me up"},{"type":"text","id":"success_message","label":"Success message","default":"Thanks for subscribing."},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"heading_size","label":"Heading size","min":20,"max":48,"step":2,"unit":"px","default":32},{"type":"range","id":"popup_radius","label":"Popup radius","min":0,"max":32,"step":2,"unit":"px","default":12},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":6},{"type":"range","id":"input_radius","label":"Input radius","min":0,"max":24,"step":2,"unit":"px","default":6},{"type":"header","content":"Colors"},{"type":"color","id":"popup_background","label":"Background","default":"#ffffff"},{"type":"color","id":"popup_text_color","label":"Text","default":"#0a1432"},{"type":"color","id":"popup_muted_color","label":"Secondary text","default":"#5a6580"},{"type":"color","id":"button_color","label":"Button","default":"#0e1a3a"},{"type":"color","id":"button_hover_color","label":"Button hover","default":"#1b2d5a"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"input_background","label":"Input background","default":"#f3f6fb"},{"type":"color","id":"input_border_color","label":"Input border","default":"#aab3c5"}],"presets":[{"name":"Newsletter popup"}],"tag":null,"class":"newsletter-popup-block"}{% endschema %}